              <characteristics>
                <characteristic name="Range" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">-</characteristic>
                <characteristic name="Strength" typeId="a6383362-5aa8-4ff0-b1d0-00e059fc9d45">+2</characteristic>
                <characteristic name="AP" typeId="6abee736-f8d3-498e-97ac-a5c68445609f">-</characteristic>
                <characteristic name="Type" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Melee, Rending, Vaul&apos;s Work</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <rules>
            <rule name="Vaul&apos;s Work" id="2c51-a849-6150-a1ee" hidden="false" publicationId="3ae4-9ad8-pubN99925" page="156">
              <description>The bearer of this weapon has the Fearless special rule. In a challenge, Attacks made with this weapon have the Fleshbane and Instant Death special rules.</description>
            </rule>
          </rules>
          <infoLinks>
            <infoLink name="Rending" id="323d-c1cd-58d8-1973" hidden="false" targetId="6a76-59d1-822c-59c9" type="rule"/>
