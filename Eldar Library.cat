          </costs>
        </selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Uldanorethi Long Rifle" hidden="false" id="9650-4f44-52a2-5cd6" publicationId="3ae4-9ad8-pubN99925" page="156" collective="false">
