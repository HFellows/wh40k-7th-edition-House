          </constraints>
          <profiles>
            <profile name="The Mask of Secrets" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item" hidden="false" id="694c-fd3e-53fa-f962" publicationId="3ae4-9ad8-pubN101373" page="93">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">A model with the Mask of Secrets has the Fearless special rule. In addition, enemy models within 12&quot; of the bearer suffer -2 to their Leadership.</characteristic>
              </characteristics>
            </profile>
          </profiles>
