<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<catalogue library="true" id="0916-ed40-bf66-6213" name="Eldar Library" gameSystemId="9e00-0436-148e-24c2" gameSystemRevision="2043" revision="5" battleScribeVersion="2.03" type="catalogue" xmlns="http://www.battlescribe.net/schema/catalogueSchema">
  <sharedProfiles>
    <profile name="Aspect Armour" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item" hidden="false" id="4ea3-9fe7-4d90-bb06" publicationId="555e-9663-pubN65910" page="153">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Aspect Armour confers a 4+ Armour Save.</characteristic>
      </characteristics>
    </profile>
    <profile name="Banshee Mask" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item" hidden="false" id="2cdc-0842-5d99-1cd4" publicationId="555e-9663-pubN65910" page="153">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">A model equipped with a Banshee Mask causes Fear. In addition, models cannot fire Overwatch against units that contain at least one model equipped with a Banshee Mask.</characteristic>
      </characteristics>
    </profile>
    <profile name="Crystal Targeting Matrix" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item" hidden="false" id="382f-ad57-c20c-fe4c" publicationId="555e-9663-pubN65910" page="155">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">One use only. A non-Walker vehicle with this upgrade can fire one weapon, at the vehicle&apos;s full BS, after moving Flat Out in the Shooting phase.</characteristic>
      </characteristics>
    </profile>
    <profile name="Eldar Jetbike" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item" hidden="false" id="67f9-80c5-207b-16da" publicationId="555e-9663-pubN65910" page="153">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">A model riding an Eldar Jetbike has a 3+ Armour Save and a Twin-linked Shuriken Catapult. Their unit type also changes to Eldar Jetbike. (see 40k Rulebook)</characteristic>
      </characteristics>
    </profile>
    <profile name="Eldar Titan Holo-Fields" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item" hidden="false" id="6235-56cc-4f39-1c25" publicationId="555e-9663-pubN70264" page="220">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Whenever a model with Eldar Titan Holo-fields is hit by an attack, before rolling for Armour Penetration, or on the Destroyer table, its attacker must roll a D6. If the target model moved in its controlling player&apos;s last Movement phase and the attacking player rolls a 4+, then the hit stands, roll for Armour Penetration or on the Destroyer table as normal. If the target model did not move in its controlling player&apos;s last Movement phase then the hit stands on a 3+.</characteristic>
      </characteristics>
    </profile>
    <profile name="Ghosthelm" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item" hidden="false" id="ca07-70a6-88ea-513a" publicationId="555e-9663-pubN65910" page="153">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">If a model with a Ghosthelm suffers an unsaved Wound from Perils of the Warp, he can prevent it by immediately expending a Warp Charge (if he has one).</characteristic>
      </characteristics>
    </profile>
    <profile name="Ghostwalk Matrix" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item" hidden="false" id="5ec4-34cd-86ab-296f" publicationId="555e-9663-pubN65910" page="155">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">A vehicle with this upgrade has the Move Through Cover special rule.</characteristic>
      </characteristics>
    </profile>
    <profile name="Grenade Pack" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item" hidden="false" id="e28b-fc50-8ccf-0b93" publicationId="555e-9663-pubN65910" page="153">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Any time a unit with a Grenade Pack enters play by Deep Strike and does not suffer a Deep Strike Mishap, nominate one model in the unit immediately after it arrives. That model can make a single special shooting attack in the Movement phase with the profile below - this represents the unit&apos;s Grenade Pack attack. A unit that fires Grenade Packs in the movement phase can still shoot in the subsequent Shooting phase; however, it must target the same target unit if possible.</characteristic>
      </characteristics>
    </profile>
    <profile name="Heavy Aspect Armour" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item" hidden="false" id="db0b-5182-b154-fda6" publicationId="555e-9663-pubN65910" page="153">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Heavy Aspect Armour confers a 3+ Armour Save.</characteristic>
      </characteristics>
    </profile>
    <profile name="Heavy Weapon Platform" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item" hidden="false" id="78ad-d38e-67e7-2693" publicationId="555e-9663-pubN65910" page="153">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">One Guardian from the same unit as, and within 2&quot; of, a Heavy Weapon Platform may fire the platform instead of his Shuriken Catapult, counting as having the Relentless special rule. If there are no Guardians left in the unit, remove the Heavy Weapons Platform as a casualty. Weapons Platform models are ignored when allocating Wounds from Look Out, Sir rolls.</characteristic>
      </characteristics>
    </profile>
    <profile name="Holo-fields" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item" hidden="false" id="1ab8-31f6-2817-ceda" publicationId="555e-9663-pubN65910" page="155">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">A vehicle with Holo-fields has a 5+ invulnerable save unless it is Immobilized.</characteristic>
      </characteristics>
    </profile>
    <profile name="Improved Holo-fields" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item" hidden="false" id="c749-d216-03f7-f39a" publicationId="555e-9663-pubN70264">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">A vehicle with Improved Holo-fields has a 4+ Invulnerable Save unless it is immobilized.</characteristic>
      </characteristics>
    </profile>
    <profile name="Mandiblasters" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item" hidden="false" id="a733-49b0-1a58-c71e" publicationId="555e-9663-pubN65910" page="154">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">During the Fight sub-phase, at the start of the Initiative 10 step, roll a D6 for each model equipped with Mandiblasters. On a result of 4+, an enemy unit that is engaged with the model (attacking player&apos;s choice) suffers a single Wound (saving throws can be taken as normal). Gargantuan Creatures suffer a Wound on a result of 6+ instead of 4+. If a character equipped with Mandiblasters is fighting in a challenge, the Wound must be allocated to his opponent.</characteristic>
      </characteristics>
    </profile>
    <profile name="Mindshock Pod" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item" hidden="false" id="be98-135e-8e71-3502" publicationId="555e-9663-pubN65910" page="155">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Enemy models within 12&quot; of a model equipped with a Mindshock Pod subtract 2 from their Leadership when taking Morale, Pinning and Fear tests.</characteristic>
      </characteristics>
    </profile>
    <profile name="Phoenix Armour" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item" hidden="false" id="8f68-5db2-2983-0f3a" publicationId="555e-9663-pubN65910" page="153">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Phoenix Armour confers a 2+ Armour Save.</characteristic>
      </characteristics>
    </profile>
    <profile name="Power Field" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item" hidden="false" id="ce2a-731c-90c3-f4b2" publicationId="555e-9663-pubN65910" page="155">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">A model with this upgrade has a 5+ Invulnerable Save.</characteristic>
      </characteristics>
    </profile>
    <profile name="Reaper Rangefinder" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item" hidden="false" id="63b1-d94e-d5e8-1b6a" publicationId="555e-9663-pubN65910" page="154">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Enemies cannot take Jink saves against shots fired by a model equipped with a Reaper Rangefinder.</characteristic>
      </characteristics>
    </profile>
    <profile name="Rune Armour" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item" hidden="false" id="5ea3-45bc-4196-f789" publicationId="555e-9663-pubN65910" page="153">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Rune Armour confers a 4+ Invulnerable Save.</characteristic>
      </characteristics>
    </profile>
    <profile name="Scattershield" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item" hidden="false" id="95c5-ed3e-dc55-fdae" publicationId="555e-9663-pubN65910" page="154">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">The bearer has a 5+ Invulnerable Save. Whenever the bearer passes one or more saving throws using its Scattershield, all enemy units within 6&quot; must test as if they had just been hit by a weapon with the Blind special rule.</characteristic>
      </characteristics>
    </profile>
    <profile name="Serpent Shield" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item" hidden="false" id="c0c7-192e-5ecf-554e" publicationId="555e-9663-pubN65910" page="155">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">All penetrating hits inflicted against the front armor of a vehicle equipped with a Serpent Shield are downgraded to glancing hits on a D6 roll of 4+. Hits from the side are downgraded on a 5+.  Once per game, the Serpent Shield can be used as a weapon in the controlling player&apos;s Shooting phase, with the profile listed below. This is treated as a hull-mounted weapon that is pointing forward. For the remainder of the battle after the shooting attack has been resolved, all subsequent hits against the vehicle are treated as though the vehicle was not equipped with a Serpent Shield.</characteristic>
      </characteristics>
    </profile>
    <profile name="Shadow Spectre Jet Pack" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item" hidden="false" id="0012-f7a2-be89-ca13" publicationId="555e-9663-pubN70264" page="135">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">A model with a Shadow Spectre Jet Pack gains the Jet Pack unit type as described in the 40k Rulebook, granting them the Bulky, Deep Strike, and Relentless special rules when moving using the Jet Pack rules.</characteristic>
      </characteristics>
    </profile>
    <profile name="Spectre Holo-Field" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item" hidden="false" id="9052-521c-402a-668d" publicationId="555e-9663-pubN70264" page="135">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">On any turn in which a model with a Spectre Holo-Field moves in the Movement phase, it gains a 5+ cover save until its next Movement phase. If it also makes a Thrust move in the Assault phase, this cover save increases to 4+. Note that cover saves granted by the Spectre Holo-Field do stack with cover saves provided by the Stealth or Shrouded Special Rules, but not those provided by terrain features or fortifications.</characteristic>
      </characteristics>
    </profile>
    <profile name="Spirit Stones" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item" hidden="false" id="eaff-e101-2094-e5f2" publicationId="555e-9663-pubN65910" page="155">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">A vehicle with this upgrade ignores Crew Shaken results on a roll of 2+ and Crew Stunned results on a roll of 4+. Roll immediately when the result is suffered.</characteristic>
      </characteristics>
    </profile>
    <profile name="Swooping Hawk Wings" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item" hidden="false" id="1c80-a767-5a27-359b" publicationId="555e-9663-pubN65910" page="154">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">A model equipped with Swooping Hawk Wings gains the Jump unit type as described in the 40k Rulebook. When a unit composed entirely of models equipped with Swooping Hawk Wings uses its jump packs in the Movement phase, it can move up to 18&quot; instead of 12&quot;. Furthermore, the unit can choose to Skyleap instead of moving in the Movement phase, as long as it did not arrive from Reserves that turn and is not locked in combat or Falling Back. A Skyleaping unit is removed from the board and placed in Ongoing Reserve.</characteristic>
      </characteristics>
    </profile>
    <profile name="Vectored Engines" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item" hidden="false" id="b266-e82f-7269-81a1" publicationId="555e-9663-pubN65910" page="155">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Unless it is Immobilised, a vehicle with this upgrade can pivot to face any direction immediately after resolving its shooting attack (in the Shooting phase).</characteristic>
      </characteristics>
    </profile>
    <profile name="Warp Jump Generator" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item" hidden="false" id="eef6-aac4-464e-1be6" publicationId="555e-9663-pubN65910" page="154">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">A model equipped with a Warp Jump Generator gains the Jet Pack unit type as described in the 40k Rulebook. In the Movement phase, a unit composed entirely of models equipped with Warp Jump Generators can choose to either move as Jet Pack Infantry or make a Warp Jump. If making a Warp Jump, it immediately moves up to 2D6+6&quot; in any direction (roll once per unit each turn), ignoring all intervening terrain and models. This move ignores dangerous terrain. If the 2D6 roll is a double 1, one member of the unit (randomly determined) is removed as a casualty. Warp Jump cannot be used when the unit is Falling Back.</characteristic>
      </characteristics>
    </profile>
    <profile name="Avenger Shuriken Catapult" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon" hidden="false" id="33d8-b17f-576c-af52" publicationId="555e-9663-pubN65910" page="150">
      <characteristics>
        <characteristic name="Range" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">18&quot;</characteristic>
        <characteristic name="Strength" typeId="a6383362-5aa8-4ff0-b1d0-00e059fc9d45">4</characteristic>
        <characteristic name="AP" typeId="6abee736-f8d3-498e-97ac-a5c68445609f">5</characteristic>
        <characteristic name="Type" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Assault 2, Bladestorm</characteristic>
      </characteristics>
    </profile>
    <profile name="Biting Blade" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon" hidden="false" id="837b-1ab7-5933-5f28" publicationId="555e-9663-pubN65910" page="151">
      <characteristics>
        <characteristic name="Range" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">-</characteristic>
        <characteristic name="Strength" typeId="a6383362-5aa8-4ff0-b1d0-00e059fc9d45">+2</characteristic>
        <characteristic name="AP" typeId="6abee736-f8d3-498e-97ac-a5c68445609f">4</characteristic>
        <characteristic name="Type" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Melee, Two-Handed</characteristic>
      </characteristics>
    </profile>
    <profile name="Chainsabres" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon" hidden="false" id="b934-9a1b-27f1-9d3b" publicationId="555e-9663-pubN65910" page="151">
      <characteristics>
        <characteristic name="Range" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">12&quot;</characteristic>
        <characteristic name="Strength" typeId="a6383362-5aa8-4ff0-b1d0-00e059fc9d45">4</characteristic>
        <characteristic name="AP" typeId="6abee736-f8d3-498e-97ac-a5c68445609f">5</characteristic>
        <characteristic name="Type" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Assault 2, Bladestorm</characteristic>
      </characteristics>
    </profile>
    <profile name="Chainsabres (Melee)" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon" hidden="false" id="b947-0d86-2dd3-d655" publicationId="555e-9663-pubN65910" page="151">
      <characteristics>
        <characteristic name="Range" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">-</characteristic>
        <characteristic name="Strength" typeId="a6383362-5aa8-4ff0-b1d0-00e059fc9d45">+1</characteristic>
        <characteristic name="AP" typeId="6abee736-f8d3-498e-97ac-a5c68445609f">5</characteristic>
        <characteristic name="Type" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Melee, Rending, Two-Weapons</characteristic>
      </characteristics>
    </profile>
    <profile name="Cloudburst Missile Launcher" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon" hidden="false" id="85b9-29c6-e6d3-21af" publicationId="555e-9663-pubN70264" page="225">
      <characteristics>
        <characteristic name="Range" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">48&quot;</characteristic>
        <characteristic name="Strength" typeId="a6383362-5aa8-4ff0-b1d0-00e059fc9d45">8</characteristic>
        <characteristic name="AP" typeId="6abee736-f8d3-498e-97ac-a5c68445609f">3</characteristic>
        <characteristic name="Type" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Heavy 4, Interceptor, Skyfire, Sunder</characteristic>
      </characteristics>
    </profile>
    <profile name="Death Spinner" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon" hidden="false" id="9525-8c37-799e-2993" publicationId="555e-9663-pubN65910" page="150">
