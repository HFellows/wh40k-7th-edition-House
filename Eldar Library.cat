              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">If a model with the Starmist Raiment Runs in its Shooting phase, it has a 3+ Invulnerable save until the start of its next Shooting phase.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
