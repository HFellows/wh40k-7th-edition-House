          </infoLinks>
          <costs>
            <cost name="pts" typeId="points" value="15"/>
          </costs>
        </selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Starmist Raiment" hidden="false" id="25b9-89d7-25ed-f9b2" publicationId="3ae4-9ad8-pubN101373" page="93" collective="false">
