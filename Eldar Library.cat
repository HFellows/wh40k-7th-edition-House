    <profile name="Venom Blade" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon" hidden="false" id="ac6e-9757-f843-eb68" publicationId="3ae4-9ad8-pubN99804">
