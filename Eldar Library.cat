            <constraint type="max" value="1" field="selections" scope="roster" shared="true" id="e2da-1d1f-a81d-e5fb" percentValue="false" includeChildSelections="true" includeChildForces="false"/>
          </constraints>
          <rules>
            <rule name="The Spirit Stone of Anath&apos;lan" id="c516-ea8e-351a-e568" hidden="false" publicationId="3ae4-9ad8-pubN99925" page="156">
              <description>Every time the bearer of the Spirit Stone of Anath&apos;lan attempts to manifest a psychic power, he can choose to reduce the Warp Charge cost by 1 (to a minimum of 1). If he does so, he cannot use his rune armour&apos;s invulnerable save until the start of his next turn.</description>
            </rule>
          </rules>
          <costs>
            <cost name="pts" typeId="points" value="15"/>
          </costs>
