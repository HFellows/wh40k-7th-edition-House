    <profile name="Tanglefield Grenade" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon" hidden="false" id="7839-aa34-8cfc-96ec" publicationId="3ae4-9ad8-pubN65739" page="155">
