            <constraint type="max" value="1" field="selections" scope="roster" shared="true" id="a7fc-f3e1-92dc-83ad" percentValue="false" includeChildSelections="true" includeChildForces="false"/>
          </constraints>
          <profiles>
            <profile name="Firesabre" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon" hidden="false" id="701d-6aaf-8867-15f4" publicationId="3ae4-9ad8-pubN99925" page="156">
              <characteristics>
                <characteristic name="Range" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">-</characteristic>
                <characteristic name="Strength" typeId="a6383362-5aa8-4ff0-b1d0-00e059fc9d45">+1</characteristic>
                <characteristic name="AP" typeId="6abee736-f8d3-498e-97ac-a5c68445609f">3</characteristic>
                <characteristic name="Type" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Melee, Soulblaze, Wildfire</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <rules>
            <rule name="Wildfire" id="5fee-12fb-26a6-1932" hidden="false" publicationId="3ae4-9ad8-pubN104610" page="69">
              <description>Whenever the Firesabre&apos;s Soul Blaze rule inflicts one or more unsaved Wounds, roll a D6 for every unit (friend or foe, but excluding the bearer&apos;s unit) within 6&quot; of the unit that suffered the Wound. On a roll 6, that unit is set ablaze as for the Soul Blaze special rule (this Soul Blaze does not benefit from he Wildfire special rule).</description>
            </rule>
          </rules>
          <infoLinks>
            <infoLink name="Soul Blaze" id="973d-0165-d8e8-f28d" hidden="false" targetId="acb1-64c4-ef54-3a55" type="rule"/>
          </infoLinks>
          <costs>
            <cost name="pts" typeId="points" value="30"/>
          </costs>
        </selectionEntry>
        <selectionEntry type="upgrade" import="true" name="The Spirit Stone of Anath&apos;lan" hidden="false" id="bb8d-c200-7994-2570" publicationId="3ae4-9ad8-pubN99925" page="156" collective="false">
