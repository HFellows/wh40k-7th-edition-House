    <selectionEntry id="d0df-e295-d66f-9dff" name="Lynx [FW]" publicationId="555e-9663-pubN70264" page="194" hidden="false" collective="false" import="true" type="unit">
      <profiles>
        <profile id="7f27-4dec-34a4-5d64" name="Lynx" publicationId="555e-9663-pubN70264" page="194" hidden="false" typeId="3a08-ea03-a598-8615" typeName="Flyer">
          <characteristics>
            <characteristic name="BS" typeId="9878-e3f6-b7b4-7225">4</characteristic>
            <characteristic name="Front" typeId="3a4e-bc1d-4a12-7176">12</characteristic>
            <characteristic name="Side" typeId="d12e-7bdb-191c-4849">12</characteristic>
            <characteristic name="Rear" typeId="a4cb-791a-6a75-4e4a">11</characteristic>
            <characteristic name="HP" typeId="93e6-d4b1-28a8-944b">5</characteristic>
            <characteristic name="Type" typeId="eb65-838c-8eaa-8b5d">Vehicle (Flyer, Hover)</characteristic>
            <characteristic name="Combat Role" typeId="d477-c087-173f-9f1c">Attack Flyer (see Lynx Combat Role)</characteristic>
            <characteristic name="Pursuit" typeId="e04d-332e-8b52-0071">2</characteristic>
            <characteristic name="Agility" typeId="ae34-f5c0-19af-4883">1</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule id="fc43-1ad1-929c-cd7b" name="Sky-Hunter" publicationId="555e-9663-pubN70264" page="194" hidden="false">
          <description>As a lumbering airborne combatant, the Lynx may not Jink and may only fire Snap Shots while operating as a Zooming Flyer, but when operating in Hover mode, the Lynx counts as a Fast Skimmer with the Tank type.

The Controlling player may choose to have a Lynx deployed on the table at the beginning of the game in Hover mode as a Fast Skimmer. If this option is utilized then the Lynx may not revert to being a Zooming Flyer until the start of turn 2.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="5245-9ad5-bd58-ecfe" hidden="false" targetId="243a-b08c-3c8c-c363" type="rule" name="Deep Strike"/>
        <infoLink id="a5be-438c-5cee-7dc9" hidden="false" targetId="90ff-9913-4c10-7758" type="rule" name="Lynx Combat Role"/>
      </infoLinks>
      <selectionEntryGroups>
        <selectionEntryGroup id="9fb0-2af9-a9a1-8b78" name="Primary Weapon" hidden="false" collective="false" import="true" defaultSelectionEntryId="06c5-68c9-94b9-b8e1">
          <constraints>
            <constraint field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="minSelections" type="min"/>
            <constraint field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="maxSelections" type="max"/>
