    <selectionEntry id="c247-a310-f563-6418" name="Seer Council" publicationId="555e-9663-pubN65910" page="141" hidden="false" collective="false" import="true" type="unit">
      <rules>
        <rule id="45dc-1514-93cf-8988" name="Psychic Bond" publicationId="555e-9663-pubN65910" page="141" hidden="false">
          <description>Both Farseers must join the Warlock Conclave before deployment, and cannot leave the unit.</description>
        </rule>
        <rule id="a137-ef26-62e4-eea0" name="Path of the Seer" publicationId="555e-9663-pubN65910" page="141" hidden="false">
          <description>If this Formation is chosen as your Primary Detachment, you can re-roll the result when rolling on the Warlord Traits table in Codex: Craftworlds.</description>
        </rule>
        <rule id="edd2-cf38-155a-d670" name="Psychic Might" publicationId="555e-9663-pubN65910" page="141" hidden="false">
          <description>When models from this Formation make Psychic tests, results of 3+ will harness a Warp Charge point instead of results of 4+.</description>
        </rule>
        <rule id="abf6-0360-5da9-56ad" name="Formation Restrictions (Seer Council)" hidden="false">
          <description>If any Farseer or Warlock in this Formation upgrades to be a Farseer Skyrunner or Warlock Skyrunner, all other models must also do so.</description>
        </rule>
      </rules>
      <selectionEntryGroups>
        <selectionEntryGroup id="b877-ea3c-48bb-d27c" name="Farseers" hidden="false" collective="false" import="true" defaultSelectionEntryId="adae-b3c9-2173-9633">
