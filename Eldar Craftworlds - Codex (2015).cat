          </profiles>
          <rules>
            <rule id="76a7-365d-db37-b54b" name="Bio-cataclysm" publicationId="555e-9663-pubN65910" page="107" hidden="false">
              <description>If a non-vehicle model is slain as a result of this weapon, centre the large blast marker over that model before removing the model as a casualty. Units suffer a number of Strength 5 AP4 hits equal to the number of models from that unit that are under the marker. These hits have the Ignores Cover special rule.</description>
            </rule>
          </rules>
          <costs>
            <cost name="pts" typeId="points" value="0"/>
          </costs>
