        <infoLink id="6634-4a04-7efd-297c" hidden="false" targetId="6799-f7d7-c08d-b146" type="rule" name="Assured Destruction"/>
      </infoLinks>
      <selectionEntries>
        <selectionEntry id="71c0-fdff-2a7e-6451" name="Phoenix Armour" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
