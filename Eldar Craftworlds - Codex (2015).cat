            <characteristic name="Ld" typeId="4a42059d-12cd-4c1f-a4c7-bb569d13eeea">10</characteristic>
            <characteristic name="Save" typeId="b215fe72-dbce-4ad6-89ec-c4bb3962c39d">5+</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule id="7ec3-be2e-c806-a719" name="Warlord Trait: Mark of the Incomparable Hunter" publicationId="555e-9663-pubN65910" page="148" hidden="false"/>
        <rule id="67fe-2690-9974-183f" name="Sharpshot" publicationId="555e-9663-pubN65910" page="101" hidden="false">
          <description>Shots fired by models with this special rule (excluding Snap Shots) are always Precision Shots as described in the Precision Shots special rule (See 40k Rulebook).</description>
        </rule>
        <rule id="e931-c01d-cf67-e93f" name="Walker of the Hidden Path" publicationId="555e-9663-pubN65910" page="101" hidden="false">
          <description>If Illic Nightspear deploys using the Infiltrate special rule, he can be deployed anywhere on the battlefield that is outside of impassable terrain, regardless of enemy proximity. If he begins the game with a unit of Rangers, all Rangers in that unit benefit from this rule.</description>
        </rule>
        <rule id="93ae-8011-1b02-9392" name="Master of Pathfinders" publicationId="555e-9663-pubN65910" page="101" hidden="false">
          <description>If Illic Nightspear joins a unit of Rangers, all Rangers in that unit gain the Sharpshot special rule whilst he is part of that unit.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="8c5e-bb78-4f82-a213" hidden="false" targetId="80e8-2653-cfa1-0d13" type="rule" name="Ancient Doom"/>
