            <profile id="47de-6149-9c03-95ed" name="Uldanorethi Long Rifle" publicationId="555e-9663-pubN116800" page="156" hidden="false" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
