          <profiles>
            <profile id="27d5-08b0-efe0-9eaa" name="Revenant Jump Jets" publicationId="555e-9663-pubN70264" page="220" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">The controlling player may choose to use the Revenant&apos;s Jump Jets in either the Movement phase or the Assault phase. If used in the Movement phase, the Revenant may move up to 36&quot;, it ignores terrain during this move but must end its move outside of Impassable terrain and at least 1&quot; away from any enemy models. If used during the Assault phase then the Revenant Titan may roll two additional D6 and total all dice rolled when determining its Charge distance, and makes D6+1 Hammer of Wrath attacks if it successfully charges instead of just one.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="0"/>
          </costs>
        </selectionEntry>
