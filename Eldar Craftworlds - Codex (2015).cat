    <selectionEntry type="unit" import="true" name="Falcons" hidden="false" id="9cf8-1cbe-7d3a-e0d9" publicationId="555e-9663-pubN65910" page="131" collective="false">
      <rules>
        <rule name="Cloudstrike" id="44db-f69b-651f-25f4" hidden="false" publicationId="555e-9663-pubN65910" page="131">
          <description>All models in the squadron gain the Deep Strike special rule. For squadrons with two models, the models must be placed within 6&quot;. For squadrons with three models, the first Falcon placed does not scatter , but the second and third Falcons must be placed within 4&quot; of the first Falcon.</description>
        </rule>
      </rules>
      <infoLinks>
