          </profiles>
          <rules>
            <rule id="68bf-2ea1-0f2f-ee5b" name="Vaul&apos;s Work" publicationId="555e-9663-pubN116800" page="156" hidden="false">
              <description>The bearer of this weapon has the Fearless special rule. In a challenge, Attacks made with this weapon have the Fleshbane and Instant Death special rules.</description>
            </rule>
          </rules>
          <infoLinks>
            <infoLink id="b8fd-c0f7-bddd-9103" hidden="false" targetId="6a76-59d1-822c-59c9" type="rule" name="Rending"/>
