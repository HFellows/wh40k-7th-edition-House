            <characteristic name="Save" typeId="b215fe72-dbce-4ad6-89ec-c4bb3962c39d">6+/4++</characteristic>
          </characteristics>
        </profile>
        <profile id="8e5b-0125-ce0a-c292" name="Yvraine (Psyker)" publicationId="555e-9663-pubN66004" hidden="false" typeId="bc97-dea9-9e88-bb7d" typeName="Psyker">
          <characteristics>
            <characteristic name="Mastery Level" typeId="ca56-02c3-af4b-ea2a">2</characteristic>
            <characteristic name="Disciplines" typeId="ea53-f5c7-08e4-980c">Daemonology (Sanctic), Revenant</characteristic>
          </characteristics>
        </profile>
        <profile id="6e1a-db95-8c8b-3948" name="Warlord Trait: Favoured of Ynnead" publicationId="555e-9663-pubN66004" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Your Warlord and their unit can make a Soulburst action when they are within 14&quot; of a unit that is destroyed, rather than 7&quot;.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule id="6086-2f1b-bc4a-62dd" name="Gyrinx Familiar" publicationId="555e-9663-pubN66004" hidden="false">
          <description>At the start of each Psychic phase, generate D3 extra Warp Charge points.  Only Yvraine can use these Warp Charge points.</description>
        </rule>
        <rule id="cb55-a275-4d61-ec64" name="Herald of Ynnead" publicationId="555e-9663-pubN66004" hidden="false">
          <description>Whenever an Aeldari model is slain within 7&quot; of Yvraine, roll a dice.  On a 4+, Yvraine immediately regains a lost Wound.  If that model was a Psyker, add 1 to Yvraine&apos;s Master Level (to a maximum of Master Level 4) and immediately generate another psychic power for her.</description>
        </rule>
      </rules>
