          <profiles>
            <profile id="70a3-3977-891c-d785" name="Wasp Jump Pack" publicationId="555e-9663-pubN70264" page="218" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">This can be used in either the Movement phase or Assault phase, but not both in the same turn. If used in the Movement phase, the Wasp Assault Walker may move up to 12&quot; and no less than 8&quot; in any direction, ignoring intervening terrain and models - when moving in this fashion, the Wasp Assault Walker may only fire Snap Shots in the following Shooting phase. If used in the Assault phase, the Wasp Assault Walker may roll an additional D6 when determining Charge distance and use the two highest results, and additionally gains the Hammer of Wrath special rule for that phase, inflicting D6+1 hits instead of just one.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="0"/>
          </costs>
        </selectionEntry>
