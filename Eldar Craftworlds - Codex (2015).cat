      <rules>
        <rule id="70a5-571b-8254-756f" name="Warlord Trait: Twilight Terror" publicationId="555e-9663-pubN70264" page="139" hidden="false">
          <description>Any enemy unit within 12&quot; of Irillyth or any unit he has joined must pass a Leadership test when attempting to make a Shooting attack against Irillyth or the unit he has joined. If they fail this test, they may only fire Snap Shots. The effects of the Shadow of Death apply to this test.</description>
        </rule>
      </rules>
