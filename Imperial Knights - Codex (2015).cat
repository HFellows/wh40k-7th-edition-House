    <profile name="Vortex Missile" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon" hidden="false" id="414e-838f-3de8-ed27" publicationId="2be8d152--pubN156636" page="0">
