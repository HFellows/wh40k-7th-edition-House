                        <rule id="0590-15f0-0d53-c557" name="Rad-phage" hidden="false">
                          <description>A model which loses one or more
                                                        wounds to an attack with this special rule
                                                        and survives has its Toughness value reduced
                                                        by -1 for the rest of the battle.</description>
                        </rule>
