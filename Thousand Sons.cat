            <characteristic name="Type" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Melee, Bane of Wisdom, Daemon Weapon, Force</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule name="Bane of Wisdom" id="760a-96c2-3f23-8084" hidden="false">
          <description>Against non-vehicle targets, the S value of the Seer&apos;s Bane is equal to the bearer&apos;s Leadership characteristic, and all To Wound rolls are made against the target&apos;s Leadership characteristic instead of their Toughness. However, use the target&apos;s Toughness values as normal for determining whether or not the Seer&apos;s Bane inflicts Instant Death</description>
        </rule>
      </rules>
