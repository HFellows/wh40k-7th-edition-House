      <rules>
        <rule name="Lord of the Silver Tower" id="bba3-e5fa-61d5-7302" hidden="false">
          <description>Once per battle, instead of firing in the Shooting phase, an Exalted Sorcerer can call upon the deadly firepower of his Silver Tower in the form of a coruscating beam.</description>
        </rule>
      </rules>
