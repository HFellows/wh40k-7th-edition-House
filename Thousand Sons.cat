              </constraints>
              <rules>
                <rule name="Dedication of Tzeentch" id="d182-3530-9541-f300" hidden="false" page="0">
                  <description>May re-roll all invunerable save rolls of a 1. All Heavy Flamers equipped have Soul Blaze</description>
