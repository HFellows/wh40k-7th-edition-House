      <rules>
        <rule name="Unnatural Predator" id="c55e-fb62-bc03-6ab9" hidden="false">
          <description>At the start of play, nominate one enemy Flyer, Flying Monstrous Creature or Gargantuan Creature (including in reserve). 
When making armour penetration/To wound rolls against the chosen model, all rolls of a 1 may be re-rolled.</description>
        </rule>
