  <sharedProfiles>
    <profile name="Armour of Shrieking Souls" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item" hidden="false" id="3671-3547-55c4-af84" page="0">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">5+ Invul save. Model that cause the would suffer S 4 AP 2 hit with Ignore Cover rule</characteristic>
      </characteristics>
    </profile>
    <profile name="Armoured Ceramite" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item" hidden="false" id="b640-0518-bd47-8cbe">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Enemies shooting at a model with this rule do not get the second dice from Melta.</characteristic>
      </characteristics>
    </profile>
    <profile name="Aura of Dark Glory" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item" hidden="false" id="48cf-03db-4323-cdfa">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">5+ Invunerable save</characteristic>
      </characteristics>
    </profile>
    <profile name="Blight Grenades" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item" hidden="false" id="2c2b-0be6-a82f-2f03">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Blight Grenades count as both Assault and Defensive Grenades.</characteristic>
      </characteristics>
    </profile>
    <profile name="Chaos Bikes" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item" hidden="false" id="5032-d457-56cf-c87e">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Changes unit type to Bike. The bike is fitted with a single twin-linked Boltgun</characteristic>
      </characteristics>
    </profile>
    <profile name="Combat Familiar" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item" hidden="false" id="5838-dc07-809c-b171">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Provides two extra Strength 4 AP - attacks.</characteristic>
      </characteristics>
    </profile>
    <profile name="Daemonic Possession" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item" hidden="false" id="51ac-e51a-8af7-2eb5">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Reduces BS to 3. Ignores Crew shaken and stunned results on a 2+.  Roll a D6 each embark/disembark. On a 1, the vehicle eats a random model in the unit (remove from play, no saves allowed) and reagins a lost hull point.</characteristic>
      </characteristics>
    </profile>
    <profile name="Destroyer Blades" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item" hidden="false" id="5016-e20e-5a3c-a874">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Any unit that is Tank Shocked from destroyer blades takes D6 Str 5 AP - hits. If they perform Death or Glory, it is 2D6 instead.</characteristic>
      </characteristics>
    </profile>
    <profile name="Dirge Caster" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item" hidden="false" id="d8c9-8129-534a-c0d1">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Enemies within 6&quot; of the Dirge Caster equipped vehicle cannot fire Overwatch.</characteristic>
      </characteristics>
    </profile>
    <profile name="Disc of Tzeentch" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item" hidden="false" id="36c9-ac55-110e-9ad1">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">+1 Attack and becomes Jetbike</characteristic>
      </characteristics>
    </profile>
    <profile name="Frag Assault Launchers" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item" hidden="false" id="ddd0-30dc-9426-10ab">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Any unit charging into close combat on the same turn as it disembarks from this vehicle counts as having frag grenades.</characteristic>
      </characteristics>
    </profile>
    <profile name="Gift of Mutation" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item" hidden="false" id="76bd-ba02-98e4-f165">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Before deployment, roll on the Chaos Boon table. Ignore Spawnhood and Dark Apotheosis results.</characteristic>
      </characteristics>
    </profile>
    <profile name="Ichor Blood" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item" hidden="false" id="0dea-70e0-84ff-25f3">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Any model who causes an unsaved wound against the bearer in the Fight sub-phase takes a Strength 3 AP 4 hit per wound caused.</characteristic>
      </characteristics>
    </profile>
    <profile name="Inferno bolts" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item" hidden="false" id="0d99-7376-94d0-4e34" page="0">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Shots from a boltgun or bolt pistol are AP3.</characteristic>
      </characteristics>
    </profile>
    <profile name="Juggernaut of Khorne" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item" hidden="false" id="d050-1255-553e-568d">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">The model gains +1 Toughness, +1 Wounds and +1 Attacks. Becomes Cavalry</characteristic>
      </characteristics>
    </profile>
    <profile name="Jump Packs" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item" hidden="false" id="e2a0-f2b5-ba1a-0475">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Changes unit type to Jump</characteristic>
      </characteristics>
    </profile>
    <profile name="Lash of Torment" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item" hidden="false" id="cec1-68eb-8867-746c" page="0">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">-1 A to all enemy model in base contact. Give Lucius Shred special rule.</characteristic>
      </characteristics>
    </profile>
    <profile name="Lasher Tendrils" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item" hidden="false" id="4f64-59e3-fc74-9d92">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each set of Lasher Tendrils reduces all models in base contacts&apos; Attack stat by 1 (to a minimum of 1). Multiple sets are Cumulative.</characteristic>
      </characteristics>
    </profile>
    <profile name="Maelific Ammunition" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item" hidden="false" id="61b3-acd6-e445-1980">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Confers Rending</characteristic>
      </characteristics>
    </profile>
    <profile name="Mechatendrils" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item" hidden="false" id="e55f-c392-0415-9228">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Gains +2 Attacks. Also includes a Flamer and Meltagun, which the bearer can choose to fire both or one and another weapon in each shooting phase.</characteristic>
      </characteristics>
    </profile>
    <profile name="Palaquin of Nurgle" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item" hidden="false" id="929c-d28f-f97a-6f8f">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Gains +2 Wounds, +1 Attack and becomes Very Bulky</characteristic>
      </characteristics>
    </profile>
    <profile name="Siege Shield" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item" hidden="false" id="db78-ba27-de57-d0a9">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">The Vehicle automatically passes Dangerous Terrain tests.</characteristic>
      </characteristics>
    </profile>
    <profile name="Sigil of Corruption" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item" hidden="false" id="8bad-0087-ce33-749e" page="0">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Confers a 4+ Invulnerable Save</characteristic>
      </characteristics>
    </profile>
    <profile name="Spell Familiar" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item" hidden="false" id="11ae-7fab-9eb1-4ecf">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">The bearer may re-roll failed Psychic tests.</characteristic>
      </characteristics>
    </profile>
    <profile name="Steed of Slaanesh" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item" hidden="false" id="9c7f-9bf5-b8cb-7054">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Gains +1 Attack and +3&quot; to his Run moves. Also gains Outflank and Acute Senses. Becomes Cavalry.</characteristic>
      </characteristics>
    </profile>
    <profile name="Terminator Armour" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item" hidden="false" id="fa17-6f34-4810-d62b">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">2+/5++, have the Bulky, Deep Strike, Relentless special rules, and may not make sweeping advances.</characteristic>
      </characteristics>
    </profile>
    <profile name="Warpflame Gargoyles" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item" hidden="false" id="80bf-ad9e-1655-2e2f">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">All weapons on the Vehicle have Soul Blaze</characteristic>
      </characteristics>
    </profile>
