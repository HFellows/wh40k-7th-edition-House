    <selectionEntry type="upgrade" import="true" name="Dimensional Key" hidden="false" id="c450-5809-9084-965b" page="0" collective="false">
      <constraints>
        <constraint type="max" value="1" field="selections" scope="roster" shared="true" id="a01e-3cb9-3451-f61c" percentValue="false" includeChildSelections="true" includeChildForces="false"/>
      </constraints>
      <profiles>
        <profile name="Dimensional Key" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item" hidden="false" id="12b3-4f86-4482-7b84">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">When the bearer kills an enemy model in the fight sub-phase the Dimensional Key activates.  All enemy models within 12&quot; of the key&apos;s bearer suffer difficult and dangerous terrain tests for that phase.  All friendlies arriving from DS afterwards do not scatter.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <costs>
        <cost name="pts" typeId="points" value="25"/>
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Dirge Caster" hidden="false" id="0499-5ac2-0b90-84e4" collective="false">
      <constraints>
