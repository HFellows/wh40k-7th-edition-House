    <selectionEntry id="87b3-cde1-38bf-a82e" name="Battle Sister Squad" publicationId="818a0a0f--pubN69117" page="0" hidden="false" collective="false" import="true" type="unit">
      <profiles>
        <profile id="258b-9240-3857-4d0b" name="Light of the Emperor" publicationId="818a0a0f--pubN68426" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">One use only. This Act of Faith can be used either in your Shooting phase or in either player&apos;s Assault phase. If successful, all models in the Battle Sisters&apos; unit gain the Preferred Enemy special rule until the end of the current phase.</characteristic>
