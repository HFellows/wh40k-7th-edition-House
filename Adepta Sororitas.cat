    <selectionEntry id="ad5c-0613-b637-3961" name="Sororitas Rhino" publicationId="818a0a0f--pubN68426" page="0" hidden="false" collective="false" import="true" type="upgrade">
      <rules>
        <rule id="6abf-3d77-d158-e5dd" name="Repair" hidden="false">
          <description>If a Rhino is Immobilised then in susequent turns it may attempt to repair itself instead of shooting.  Roll a D6 in the Shooting phase.  On a roll of a 6+ the vehicle is no longer immobilized.</description>
        </rule>
      </rules>
