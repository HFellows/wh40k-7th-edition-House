              <profiles>
                <profile name="Chirurgeon&apos;s Tools" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item" hidden="false" id="456d-4e1f-5a30-e8a9">
                  <characteristics>
