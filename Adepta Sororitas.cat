            <characteristic name="Strength" typeId="a6383362-5aa8-4ff0-b1d0-00e059fc9d45">+2</characteristic>
            <characteristic name="AP" typeId="6abee736-f8d3-498e-97ac-a5c68445609f">4</characteristic>
            <characteristic name="Type" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Melee, Chaos Bane, Concussive, Master-Crafted</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule id="7a9b761f-8b1c-39fb-071b-8f10d42759b8" name="Chaos Bane" publicationId="818a0a0f--pubN68426" page="0" hidden="false">
          <description>The Mace of Valaan gains the Fleshbane and Armourbane special rules when the wielder is within 6&quot; of one or more models with the Daemon special rule.</description>
        </rule>
      </rules>
      <costs>
        <cost name="pts" typeId="points" value="25"/>
      </costs>
