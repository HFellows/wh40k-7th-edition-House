      <profiles>
        <profile id="b0c05dd7-df79-9c7c-1ff0-e380bcc010bb" name="The Book of St. Lucius" publicationId="818a0a0f--pubN68426" page="0" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">All friendly units within 12&quot; of the bearer automatically pass any Fear or Regroup tests they are required to take</characteristic>
          </characteristics>
