    <selectionEntry id="9343473b-bfd7-fb87-5f90-e1a714038ac1" name="Relic - The Cloak of St. Aspira" publicationId="818a0a0f--pubN68426" page="0" hidden="false" collective="false" import="true" type="upgrade">
      <constraints>
        <constraint field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="maxSelections" type="max"/>
        <constraint field="selections" scope="roster" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="maxInRoster" type="max"/>
      </constraints>
      <profiles>
        <profile id="533f2fac-185f-9f5e-6144-afb861c672c8" name="The Cloak of St. Aspira" publicationId="818a0a0f--pubN68426" page="0" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">The wearer of the Cloak of St. Aspira re-rolls all failed armour saving throws and Shield of Faith invulnerable saving throws.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <costs>
        <cost name="pts" typeId="points" value="20"/>
      </costs>
    </selectionEntry>
    <selectionEntry id="f7368c73-6718-03ef-e3b2-4bfd4d2e2178" name="Relic - The Litanies of Faith" publicationId="818a0a0f--pubN68426" page="0" hidden="false" collective="false" import="true" type="upgrade">
      <constraints>
        <constraint field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="maxSelections" type="max"/>
        <constraint field="selections" scope="roster" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="maxInRoster" type="max"/>
      </constraints>
      <profiles>
        <profile id="efe9cd81-56d6-4ba1-03e9-6c6c0dbd3351" name="The Litanies of Faith" publicationId="818a0a0f--pubN68426" page="0" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">The bearer, the bearer&apos;s unit and any Independent Character that has joined the bearer&apos;s unit automatically pass any Leadership test required when attempting to use either an Act of Faith or a War Hymn.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <costs>
        <cost name="pts" typeId="points" value="15"/>
      </costs>
    </selectionEntry>
    <selectionEntry id="6b4c4371-f527-6dab-7b61-28475533d40b" name="Relic - The Mace of Valaan" publicationId="818a0a0f--pubN68426" page="0" hidden="false" collective="false" import="true" type="upgrade">
