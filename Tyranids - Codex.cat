    <profile name="Toxin Sacs" id="de679956-7232-1b2a-8277-213c805893e4" hidden="false" page="67" publicationId="f2f40acf--pubN65999" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">If a model has the toxin sacs biomorph, its close combat attacks have the Poisoned special rule.</characteristic>
