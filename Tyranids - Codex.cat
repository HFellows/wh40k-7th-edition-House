              </costs>
              <profiles>
                <profile name="Swarm Incubation Chamber" id="8167-cc7e-af23-26dc" hidden="false" page="132" publicationId="f2f40acf--pubN169697" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">The Hierophant Bio-titan gains a Transport capacity of 20 models, and friendly units chosen from Codex: Tyranids may embark and disembark from it as though it was a Vehicle with the Transport type and Assault Vehicle special rule.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
