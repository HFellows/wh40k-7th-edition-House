    <selectionEntry id="f3a5ae8c-f384-825a-2579-1c6f58cb5beb" name="Skyblight Swarm" publicationId="f2f40acf--pubN126683" page="0" hidden="false" collective="false" import="true" type="unit">
      <rules>
        <rule id="8abe2a51-724d-fcab-e030-9f3601f91193" name="Skyswarm" publicationId="f2f40acf--pubN126704" hidden="false">
          <description>Each time a Gargoyle Brood from this Formation is completely destroyed, roll a D6: on a 4+ you can immediately place a new unit into Ongoing Reserve that is identical in terms of the original number of models, weapons and upgrades to the unit that was just destroyed. These new units count as being part of the original Formation, so roll a D6 as described above if they are subsequently destroyed. Victory points are awarded as normal for new units in this Formation that have been completely destroyed.</description>
        </rule>
        <rule id="00c14fe1-e5a5-55f1-3505-51cba17c3366" name="Objective Secured" publicationId="f2f40acf--pubN126683" hidden="false"/>
      </rules>
      <categoryLinks>
        <categoryLink id="f3a5ae8c-f384-825a-2579-1c6f58cb5beb-28b94f51-e66b-4096-aa59-0c9df620a77d" hidden="false" targetId="28b94f51-e66b-4096-aa59-0c9df620a77d" primary="true" name="Formation"/>
