    <selectionEntry id="07b3-f815-efdb-d59c" name="Toxicrene" hidden="false" collective="false" import="true" type="unit">
      <rules>
        <rule id="25c6-b79e-2606-6aad" name="Hypertoxic" hidden="false">
          <description>Any hit inflicted by this model that has the Poisoned special rule (including any hits caused by its choking cloud) gains the Instant Death special rule on a To Wound roll of a 6.</description>
        </rule>
        <rule name="Choking Spore Cloud" id="6830-77e6-7a1b-15d1" hidden="false">
          <description>Enemy models within 6&quot; of a model with this keyword at the beginning of the shooting phase and the end of the assault phase suffer a str 2 ap - poison 4+ hit</description>
        </rule>
        <rule name="Poisoned Bioform" id="bb08-1cd0-44ec-a18b" hidden="false">
          <description>This model is immune to all Poison attacks</description>
        </rule>
