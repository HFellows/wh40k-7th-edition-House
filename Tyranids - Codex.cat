    <selectionEntry id="5a84-a8bc-5ce8-9341" name="Haruspex" page="0" hidden="false" collective="false" import="true" type="model">
      <rules>
        <rule id="5697-8a9a-e61c-4e06" name="Feeder-beast" publicationId="f2f40acf--pubN65999" page="51" hidden="false">
          <description>If a Haruspex inflicts at least one unsaved Wound in the Assault phase, then at the end of
that phase it recovers a single Wound lost earlier in the battle. In addition enemies count toward Friend equal Food.</description>
        </rule>
        <rule id="3af9-d91a-0e22-5060" name="Rapacious Hunger" publicationId="f2f40acf--pubN65999" page="51" hidden="false">
          <description>In the turn in which a Haruspex charges, every unsaved Wound that it inflicts in close
combat immediately allows it to make an additional Attack. These bonus Attacks cannot
generate further Attacks. Wounds that inflict Instant Death only generate one bonus
Attack. Note that Wounds caused by its Hammer of Wrath, acid blood or tail biomorph do
not benefit from this rule.</description>
        </rule>
        <rule name="Maw" id="43c9-0771-daec-319d" hidden="false">
          <description>At initiative count 0 after everyone else attacks, including those with unwieldy special rule, this Monster makes a numder of attacks with its Maw that is equal to the number of enemy models in base contact</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="576e-7227-785d-1c25" hidden="false" targetId="948f850e-5bc2-9955-77c7-66ca26251928" type="rule" name="Instinctive Behaviour - Feed"/>
        <infoLink id="3c15-fe5b-0305-87d1" hidden="false" targetId="be993f25-3873-e26f-ba32-20c8e35f0618" type="rule" name="Fearless"/>
        <infoLink id="0c7a-f48a-836d-2893" hidden="false" targetId="9b74-28aa-ea04-e45b" type="profile" name="Haruspex"/>
        <infoLink id="aeb2-2757-c822-443c" hidden="false" targetId="1bb3-2856-abde-cd6d" type="rule" name="Smash"/>
        <infoLink name="Friends equal food" id="37d9-1a5a-d886-cb75" hidden="false" type="rule" targetId="b48f-94a3-4cb0-41c0"/>
        <infoLink name="Tyranid Monster" id="2bbf-6c23-32a9-7b38" hidden="false" type="rule" targetId="5024-7939-2cea-7216"/>
        <infoLink name="It Will Not Die" id="c90e-e2d5-b849-002c" hidden="false" type="rule" targetId="8de3-9e93-da02-b9dd"/>
      </infoLinks>
      <categoryLinks>
        <categoryLink id="5a84-a8bc-5ce8-9341-638d74c6-bd97-4de5-b65a-6aaa24e9f4b2" hidden="false" targetId="638d74c6-bd97-4de5-b65a-6aaa24e9f4b2" primary="true" name="Elites"/>
