    <selectionEntry name="Old One Eye" id="f7ba-63c7-0161-21ac" collective="false" hidden="false" import="true" page="94" publicationId="f2f40acf--pubN65999" type="model">
      <categoryLinks>
        <categoryLink name="HQ" id="f7ba-63c7-0161-21ac-848a6ff2-0def-4c72-8433-ff7da70e6bc7" hidden="false" primary="true" targetId="848a6ff2-0def-4c72-8433-ff7da70e6bc7"/>
