        <rule id="4c8a-406d-4dd3-fa19" name="Ideal Mission Commander" hidden="false">
          <description>If this Detachment is chosen as your Primary Detachment, you can choose to re-roll the result on the Warlord Traits table.</description>
        </rule>
        <rule id="bed9-fc12-e99c-8ff1" name="Adapted Instincts" hidden="false">
          <description>You can re-roll the Instinctive Behaviour roll for unit in this detachment.</description>
