    <selectionEntry id="6d2b-3117-1ec5-ed93" name="Harridan" publicationId="f2f40acf--pubN96677" page="0" hidden="false" collective="false" import="true" type="model">
      <rules>
        <rule id="c56f-adf0-022c-1e7c" name="Gargoyle Brood" publicationId="f2f40acf--pubN76166" page="162" hidden="false">
          <description>May act as an Open-topped transport and carry up to 20 Gargoyles of a single unit. If he is slain, the Gargoyles each pass an Initiative test or are removed as casualties.</description>
        </rule>
      </rules>
      <infoLinks>
