            <infoLink name="Snake like Body" id="dfa0-e692-1ca4-88fd" hidden="false" type="rule" targetId="6308-ef21-d982-cff0"/>
            <infoLink name="Friends equal food" id="c7ac-cc16-6328-02e5" hidden="false" type="rule" targetId="b48f-94a3-4cb0-41c0"/>
            <infoLink name="It Will Not Die" id="ea93-18ed-9c41-7a2b" hidden="false" type="rule" targetId="8de3-9e93-da02-b9dd"/>
          </infoLinks>
          <selectionEntries>
