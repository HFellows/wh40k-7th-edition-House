      <rules>
        <rule name="Symbiotic Targeting" id="f6bc-15ae-1043-d43a" hidden="false" page="50" publicationId="f2f40acf--pubN65999">
          <description>If an Exocrine does not move in its Movement phase, it gains a
+1 bonus to its Ballistic Skill until the end of its turn. An Exocrine cannot declare a charge
during the same turn that it uses this special rule.</description>
        </rule>
        <rule name="Plasma Imbued " id="7fcd-5852-a2d6-45b1" hidden="false">
          <description>An Exocrine is use to dispersing Plasma heat. Thus gains an 5+ Invul against Plasma Weapons</description>
        </rule>
      </rules>
