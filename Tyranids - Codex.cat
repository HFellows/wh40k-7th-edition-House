        <selectionEntry id="8dab0e93-d98a-aaae-7eed-11f57558c0d6" name="The Ymgarl Factor" page="0" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="maxSelections" type="max"/>
            <constraint field="selections" scope="roster" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="maxInRoster" type="max"/>
          </constraints>
          <rules>
            <rule id="c67b13a5-0b92-9e76-73d6-31f379afd931" name="The Ymgarl Factor" publicationId="f2f40acf--pubN65999" page="68" hidden="false">
              <description>At the start of every Assault phase, a model with the Ymgarl Factor must alter their form into one of the three listed below. The bonus gained lasts until the end of the phase. The same form cannot be chosen in two consecutive turns.

- Slashing Claws: The model has +1 Strength.
- Tentacled Limbs: The model has +1 Attack.
- Protective Carapace: The model&apos;s armour save is improved by 1.</description>
            </rule>
          </rules>
          <costs>
            <cost name="pts" typeId="points" value="30"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="6aa57038-53b6-787a-0c59-1425781fd5ca" name="The Reaper of Obliterax" page="0" hidden="false" collective="false" import="true" type="upgrade">
