                <constraint id="6bd8-e812-e796-059c" field="selections" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <profiles>
                <profile name="Barb Launcher" id="0ada-1109-3e0c-a973" hidden="false" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
                  <characteristics>
                    <characteristic name="Range" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">24&quot;</characteristic>
                    <characteristic name="Strength" typeId="a6383362-5aa8-4ff0-b1d0-00e059fc9d45">4</characteristic>
                    <characteristic name="AP" typeId="6abee736-f8d3-498e-97ac-a5c68445609f">-</characteristic>
                    <characteristic name="Type" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Heavy 1, Stick together, webbing</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <rules>
                <rule name="Webbing" id="06f9-6b2e-cb76-090f" hidden="false">
                  <description>Enemy units hit by this weapon count as if they are in cover for the purposes of movement. If a unit with move through cover is hit with this weapon, it does not suffer the movement penalty but loses move through cover until the begining of the tyranids players next turn. </description>
                </rule>
                <rule name="Stick together" id="9761-cc64-6b07-82af" hidden="false">
                  <description>Instead of firing normally, the player may choose to fire a single large blast with indirect0 for every 5 models in the unit, or a single small blast for every 3 models in the unit. This ignores the All together Rule and follows all the rules for shooting blast weapons.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry name="Toxin Sacs" id="1526-5086-8e61-98e9" collective="true" hidden="false" import="true" page="0" type="upgrade">
