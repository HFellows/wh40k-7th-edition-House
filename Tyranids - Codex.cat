                <characteristic name="Rear" typeId="0a9f33cb-0412-420a-89d2-20707c360bd2">11</characteristic>
                <characteristic name="I" typeId="a558b3ef-04d0-440e-a312-bac3255bf592">2</characteristic>
                <characteristic name="A" typeId="5dff3e7c-e024-4030-a71d-03195ec06ea7">3</characteristic>
                <characteristic name="HP" typeId="ae95a1af-719f-4365-b951-33cd3ca9148a">4</characteristic>
                <characteristic name="Type" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Walker (Organic)</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <rules>
            <rule name="Tyranid Monster" id="5024-7939-2cea-7216" hidden="false">
              <description>Tyranid Monsters are Large Creatures made up of many smaller highly adaptable organism. Poison only wounds them on a 4+ or worse and they have a 4++ against poison weapons.</description>
            </rule>
            <rule name="Friends equal food" id="b48f-94a3-4cb0-41c0" hidden="false">
              <description>Tyranid Monsters may &quot;feed&quot; on smaller organism to increase their chances of healing. When a friendly tyranid Infantry unit is with in 6&quot; of a monster with this rule, the Tyranid player may remove up to 6 models from the infantry unit to give the Tyranid Creature increase its It Will Not Die roll, giving it a +1 for every 2 models removed. (The amount needed to heal and max number than can be removed are doubled if the Monster is out side of synapse range)</description>
            </rule>
          </rules>
        </selectionEntry>
      </selectionEntries>
      <costs>
        <cost name="pts" typeId="points" value="0"/>
      </costs>
    </selectionEntry>
    <selectionEntry id="deba-7637-0180-2772" name="Deathleaper" publicationId="f2f40acf--pubN65999" page="88" hidden="false" collective="false" import="true" type="model">
      <constraints>
        <constraint field="selections" scope="roster" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="maxInRoster" type="max"/>
      </constraints>
      <rules>
        <rule id="1103-0fb1-ab17-4283" name="&quot;It&apos;s after me!&quot;" publicationId="f2f40acf--pubN65999" page="61" hidden="false">
          <description>Nominate an enemy character at the beginning of the game and roll a D3. Whilst
Deathleaper is alive, that model&apos;s Leadership is reduced by the result.</description>
        </rule>
        <rule id="3880-d827-aead-0a9a" name="&quot;Where is it?&quot;" publicationId="f2f40acf--pubN65999" page="61" hidden="false">
          <description>Enemy models can only fire Snap Shots when targeting Deathleaper.</description>
        </rule>
        <rule id="8717-f766-a52b-bd2a" name="Warlord Trait: Mind Eater" publicationId="f2f40acf--pubN65999" page="61" hidden="false">
          <description>Your army gains 2 Victory Points for each enemy model with the Independent
Character special rule slain by your Warlord in a challenge. Killing an
Independent Character as the result of a sweeping advance does not award
these Victory Points.</description>
        </rule>
      </rules>
      <infoLinks>
