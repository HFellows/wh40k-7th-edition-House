            <infoLink name="Toxic Miasma" id="aa8c-34c3-43a3-283d" hidden="false" targetId="fc7889a0-72a9-e4af-b6ff-e8a2e2661c61" type="profile"/>
            <infoLink name="Synapse Creature" id="5e91-ac0f-9e75-6cab" hidden="false" targetId="34a50f2a-82f2-8f06-0d60-e26e520f2add" type="rule"/>
