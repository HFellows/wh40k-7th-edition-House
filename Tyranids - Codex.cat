              <profiles>
                <profile name="Mucolid Spore" id="f2ebec2a-678a-2066-ba71-96efc2e1e249" hidden="false" publicationId="f2f40acf--pubN122049" typeId="2d6001b0-980e-46d2-bcc2-a9fc60109afd" typeName="Unit">
                  <characteristics>
