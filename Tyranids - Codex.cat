        <rule name="Psychic Hunger" id="cb4e-b496-2592-2d42" hidden="false" page="61" publicationId="f2f40acf--pubN65999">
          <description>Nominate an enemy Psyker at the beginning of the game and roll a D3. Whilst
this Neurolictor is alive, that model&apos;s Leadership is reduced by the result. and generates 1 less psychic charge to a min of 0</description>
        </rule>
        <rule name="Warlord Trait: Mind Eater" id="5ccc-e351-8754-0aca" hidden="false" page="61" publicationId="f2f40acf--pubN65999">
          <description>Your army gains 2 Victory Points for each enemy psyker model special rule slain by your Warlord. Killing an
Psyker as the result of a sweeping advance does not award
these Victory Points.</description>
        </rule>
        <rule name="Psychic Barrier" id="0af1-85f2-84f3-1003" hidden="false">
          <description>A model with this special rule has a 4+ invulnerable save.</description>
        </rule>
      </rules>
