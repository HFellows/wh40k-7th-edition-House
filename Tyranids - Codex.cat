          </characteristics>
        </profile>
        <profile name="Maw" id="213e-e96c-4c1f-1f30" hidden="false" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
          <characteristics>
            <characteristic name="Range" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">-</characteristic>
            <characteristic name="Strength" typeId="a6383362-5aa8-4ff0-b1d0-00e059fc9d45">user</characteristic>
            <characteristic name="AP" typeId="6abee736-f8d3-498e-97ac-a5c68445609f">4</characteristic>
            <characteristic name="Type" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Melee, Don&apos;t Bite the Hand  Extra attacks</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule name="Feeder-beast" id="5697-8a9a-e61c-4e06" hidden="false" page="51" publicationId="f2f40acf--pubN65999">
          <description>If a Haruspex inflicts at least one unsaved Wound in the Assault phase, then at the end of
that phase it recovers a single Wound lost earlier in the battle.</description>
        </rule>
        <rule name="Rapacious Hunger" id="3af9-d91a-0e22-5060" hidden="false" page="51" publicationId="f2f40acf--pubN65999">
          <description>In the turn in which a Haruspex charges, every unsaved Wound that it inflicts in close
combat immediately allows it to make an additional Attack. These bonus Attacks cannot
generate further Attacks. Wounds that inflict Instant Death only generate one bonus
Attack. Note that Wounds caused by its Hammer of Wrath, acid blood or tail biomorph do
not benefit from this rule.</description>
        </rule>
        <rule name="Don&apos;t bite the hand" id="43c9-0771-daec-319d" hidden="false">
          <description>The Haruspex can either attack with its fists or maw, but not both in the same fight phase,</description>
        </rule>
        <rule name="Extra attaks" id="6949-226b-96e3-30aa" hidden="false">
          <description>Models with this special rule double the amount  of attacks they have when using this weapon</description>
        </rule>
      </rules>
