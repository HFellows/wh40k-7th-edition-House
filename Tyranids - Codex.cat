          </costs>
          <infoLinks>
            <infoLink name="Very Bulky" id="199f-61af-0f66-165a" hidden="false" targetId="0489b7e8-ec5c-17db-625d-c939d408a20f" type="rule"/>
            <infoLink name="Deep Strike" id="7e0c-2de9-c591-4271" hidden="false" targetId="44d1e26e-edf6-7f5e-c0f4-8759aa455e27" type="rule"/>
            <infoLink name="Instinctive Behaviour - Feed" id="1dc1-a70d-9bd5-ff89" hidden="false" targetId="948f850e-5bc2-9955-77c7-66ca26251928" type="rule"/>
            <infoLink name="The Red Terror" id="a5b2-8b66-b434-59e5" hidden="false" targetId="9c5f-37de-4d00-bf76" type="profile"/>
            <infoLink name="Snake like Body" id="dfa0-e692-1ca4-88fd" hidden="false" targetId="6308-ef21-d982-cff0" type="rule"/>
            <infoLink name="It Will Not Die" id="ea93-18ed-9c41-7a2b" hidden="false" targetId="8de3-9e93-da02-b9dd" type="rule"/>
          </infoLinks>
          <rules>
            <rule name="Swallow Whole" id="59aa-18a1-06b5-d65e" hidden="false" page="49" publicationId="f2f40acf--pubN65999">
              <description>If the Red Terror hits with at least 3 of its close combat attacks in a
single phase (excluding its prehensile pincer attack), you may nominate a single enemy
Infantry, Jump Infantry or Jet Pack Infantry model in base contact with the Red Terror
and attempt to swallow it whole.

If you choose to do so, no To Wound rolls are made for any of the Red Terror&apos;s Attacks
(excluding its prehensile pincer attack). Instead, the nominated model must pass a single
invulnerable save (if it has one) or be removed from play as a casualty. There is no need
to decide beforehand if you will attempt to swallow a model whole; declare after rolling
To Hit. Enemy models with either the Very Bulky or Extremely Bulky special rule cannot
be nominated as targets to be Swallowed Whole. If no models in the target unit can be
nominated, the Red Terror cannot choose to Swallow Whole and must roll To Wound
normally.</description>
            </rule>
          </rules>
          <selectionEntries>
            <selectionEntry name="Prehensile Pincer" id="5c12-8e4c-b8bf-be17" collective="false" hidden="false" import="true" page="0" type="upgrade">
