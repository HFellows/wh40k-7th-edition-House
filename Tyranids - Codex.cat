        <selectionEntry name="Skyblight Swarm" id="e89d01a7-4470-55ee-912e-449457e3fc8f" collective="false" hidden="false" import="true" page="0" publicationId="f2f40acf--pubN126683" type="unit">
          <categoryLinks>
            <categoryLink name="Formation" id="e89d01a7-4470-55ee-912e-449457e3fc8f-28b94f51-e66b-4096-aa59-0c9df620a77d" hidden="false" primary="true" targetId="28b94f51-e66b-4096-aa59-0c9df620a77d"/>
