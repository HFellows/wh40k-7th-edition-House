    <selectionEntry type="upgrade" import="true" name="The Eye of Night" hidden="true" id="b63e-28e7-7def-f6f5" publicationId="5af86795--pubN111452" collective="false">
      <constraints>
        <constraint type="max" value="1" field="selections" scope="roster" shared="true" id="1ca4-3a5c-0e4e-7d55" percentValue="false" includeChildSelections="true" includeChildForces="false"/>
      </constraints>
      <profiles>
        <profile name="The Eye of Night" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon" hidden="false" id="20c7-3d61-edc8-7dba">
          <characteristics>
            <characteristic name="Range" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">Infinite</characteristic>
            <characteristic name="Strength" typeId="a6383362-5aa8-4ff0-b1d0-00e059fc9d45">5</characteristic>
            <characteristic name="AP" typeId="6abee736-f8d3-498e-97ac-a5c68445609f">4</characteristic>
            <characteristic name="Type" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Heavy 1, Haywire Maelstrom, Large Blast, Ignores Cover, One Use Only.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule name="Haywire Maelstrom" id="c4cf-c4c8-48f7-8b08" hidden="false">
          <description>Instead of making armour pen rolls, any vehicle, building or fortifications that are fully or partially underneath the blast marker suffer D3 automatic penetrating hits.</description>
        </rule>
      </rules>
      <costs>
        <cost name="pts" typeId="points" value="75"/>
      </costs>
    </selectionEntry>
