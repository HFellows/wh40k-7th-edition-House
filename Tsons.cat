      </constraints>
      <profiles>
        <profile name="Icon of Insurrection" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item" hidden="false" id="30c1-8c8e-daec-2d95">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Friendly units of Chaos Cultists or Tzaangor within 12&quot; of the bearer have the Zealot special rule.</characteristic>
