      <profiles>
        <profile name="Exalted Sorcerer" typeId="2d6001b0-980e-46d2-bcc2-a9fc60109afd" typeName="Unit" hidden="false" id="3a67-f076-0f1a-948e" page="0">
          <characteristics>
