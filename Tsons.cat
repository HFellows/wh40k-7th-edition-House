    <profile name="Armour of Shrieking Souls" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item" hidden="false" id="8b5f-6054-128b-2d08" page="0">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">5+ Invul save. Model that cause the would suffer S 4 AP 2 hit with Ignore Cover rule</characteristic>
      </characteristics>
    </profile>
    <profile name="Armoured Ceramite" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item" hidden="false" id="7c32-3340-78f7-ccd8">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Enemies shooting at a model with this rule do not get the second dice from Melta.</characteristic>
      </characteristics>
    </profile>
    <profile name="Aura of Dark Glory" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item" hidden="false" id="eed2-ba8c-e6be-502f">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">5+ Invunerable save</characteristic>
      </characteristics>
    </profile>
    <profile name="Blight Grenades" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item" hidden="false" id="3ea2-b7e8-5e07-6958">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Blight Grenades count as both Assault and Defensive Grenades.</characteristic>
      </characteristics>
    </profile>
    <profile name="Chaos Bikes" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item" hidden="false" id="10d2-c317-5959-e610">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Changes unit type to Bike. The bike is fitted with a single twin-linked Boltgun</characteristic>
      </characteristics>
    </profile>
    <profile name="Combat Familiar" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item" hidden="false" id="362e-03e2-d7ec-b4f2">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Provides two extra Strength 4 AP - attacks.</characteristic>
      </characteristics>
    </profile>
    <profile name="Daemonic Possession" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item" hidden="false" id="2725-7631-dcea-bad6">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Reduces BS to 3. Ignores Crew shaken and stunned results on a 2+.  Roll a D6 each embark/disembark. On a 1, the vehicle eats a random model in the unit (remove from play, no saves allowed) and reagins a lost hull point.</characteristic>
      </characteristics>
    </profile>
    <profile name="Destroyer Blades" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item" hidden="false" id="98ad-1e74-110f-b64e">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Any unit that is Tank Shocked from destroyer blades takes D6 Str 5 AP - hits. If they perform Death or Glory, it is 2D6 instead.</characteristic>
      </characteristics>
    </profile>
    <profile name="Dirge Caster" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item" hidden="false" id="dc56-ee1c-8f09-b615">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Enemies within 6&quot; of the Dirge Caster equipped vehicle cannot fire Overwatch.</characteristic>
      </characteristics>
    </profile>
    <profile name="Disc of Tzeentch" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item" hidden="false" id="673e-7df9-5ffd-f811">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">+1 Attack and becomes Jetbike</characteristic>
      </characteristics>
    </profile>
    <profile name="Frag Assault Launchers" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item" hidden="false" id="5d07-7828-df9f-330b">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Any unit charging into close combat on the same turn as it disembarks from this vehicle counts as having frag grenades.</characteristic>
      </characteristics>
    </profile>
    <profile name="Gift of Mutation" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item" hidden="false" id="867e-de13-c15f-1db3">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Before deployment, roll on the Chaos Boon table. Ignore Spawnhood and Dark Apotheosis results.</characteristic>
      </characteristics>
    </profile>
    <profile name="Ichor Blood" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item" hidden="false" id="4f78-da7a-5fc5-b36c">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Any model who causes an unsaved wound against the bearer in the Fight sub-phase takes a Strength 3 AP 4 hit per wound caused.</characteristic>
      </characteristics>
    </profile>
    <profile name="Inferno bolts" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item" hidden="false" id="24d5-ba58-18a6-824d" page="0">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Shots from a boltgun or bolt pistol are AP3.</characteristic>
      </characteristics>
    </profile>
    <profile name="Juggernaut of Khorne" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item" hidden="false" id="d2a2-02a4-1e9f-028e">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">The model gains +1 Toughness, +1 Wounds and +1 Attacks. Becomes Cavalry</characteristic>
      </characteristics>
    </profile>
    <profile name="Jump Packs" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item" hidden="false" id="3ace-0508-b5ba-2315">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Changes unit type to Jump</characteristic>
      </characteristics>
    </profile>
    <profile name="Lash of Torment" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item" hidden="false" id="a046-01fa-2c11-6963" page="0">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">-1 A to all enemy model in base contact. Give Lucius Shred special rule.</characteristic>
      </characteristics>
    </profile>
    <profile name="Lasher Tendrils" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item" hidden="false" id="b4af-a392-c1df-5d32">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each set of Lasher Tendrils reduces all models in base contacts&apos; Attack stat by 1 (to a minimum of 1). Multiple sets are Cumulative.</characteristic>
      </characteristics>
    </profile>
    <profile name="Maelific Ammunition" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item" hidden="false" id="e00d-11c6-7c6a-22d4">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Confers Rending</characteristic>
      </characteristics>
    </profile>
    <profile name="Mechatendrils" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item" hidden="false" id="203c-8d18-032e-2fcd">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Gains +2 Attacks. Also includes a Flamer and Meltagun, which the bearer can choose to fire both or one and another weapon in each shooting phase.</characteristic>
      </characteristics>
    </profile>
    <profile name="Palaquin of Nurgle" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item" hidden="false" id="a95a-b345-2327-10a1">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Gains +2 Wounds, +1 Attack and becomes Very Bulky</characteristic>
      </characteristics>
    </profile>
    <profile name="Siege Shield" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item" hidden="false" id="4484-d9bf-b63e-48c4">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">The Vehicle automatically passes Dangerous Terrain tests.</characteristic>
      </characteristics>
    </profile>
    <profile name="Sigil of Corruption" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item" hidden="false" id="99ed-995b-213c-5b15" page="0">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Confers a 4+ Invulnerable Save</characteristic>
      </characteristics>
    </profile>
    <profile name="Spell Familiar" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item" hidden="false" id="6366-82bf-19a3-49ba">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">The bearer may re-roll failed Psychic tests.</characteristic>
      </characteristics>
    </profile>
    <profile name="Steed of Slaanesh" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item" hidden="false" id="51da-8c40-d78b-12af">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Gains +1 Attack and +3&quot; to his Run moves. Also gains Outflank and Acute Senses. Becomes Cavalry.</characteristic>
      </characteristics>
    </profile>
    <profile name="Terminator Armour" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item" hidden="false" id="2792-0012-0d52-f2d6">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">2+/5++, have the Bulky, Deep Strike, Relentless special rules, and may not make sweeping advances.</characteristic>
      </characteristics>
    </profile>
    <profile name="Warpflame Gargoyles" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item" hidden="false" id="2a9c-58c0-304e-2478">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">All weapons on the Vehicle have Soul Blaze</characteristic>
      </characteristics>
    </profile>
