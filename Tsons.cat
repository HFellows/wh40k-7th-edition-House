          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule name="Murder" id="9bf8-0906-8cc0-01a8" hidden="false">
          <description>Immediately before the first turn, pick an enemy character. Whilst in base contact with the selected character, the murder sword become x2 S, AP 1 and gains Instant Death.</description>
        </rule>
      </rules>
      <costs>
        <cost name="pts" typeId="points" value="35"/>
