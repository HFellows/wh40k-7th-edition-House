    <selectionEntry type="upgrade" import="true" name="Dimensional Key" hidden="false" id="79ac-eba3-70bd-0f78" page="0" collective="false">
      <constraints>
        <constraint type="max" value="1" field="selections" scope="roster" shared="true" id="f86c-d273-e945-41c0" percentValue="false" includeChildSelections="true" includeChildForces="false"/>
      </constraints>
      <profiles>
        <profile name="Dimensional Key" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item" hidden="false" id="4257-5316-8ca9-ebe5">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">When the bearer kills an enemy model in the fight sub-phase the Dimensional Key activates.  All enemy models within 12&quot; of the key&apos;s bearer suffer difficult and dangerous terrain tests for that phase.  All friendlies arriving from DS afterwards do not scatter.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <costs>
        <cost name="pts" typeId="points" value="25"/>
      </costs>
    </selectionEntry>
