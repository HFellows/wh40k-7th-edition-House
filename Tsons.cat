          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Vehicle/Super-Heavy Vehicle: Gains Fear and Preferred Enemy (Space Marines) Walker: Gains Rage and Hatred (Chaos Space Marines)</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <costs>
