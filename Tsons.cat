    <selectionEntry type="upgrade" import="true" name="Last Memory of Yuranthos" hidden="true" id="bc6a-e593-8148-894c" publicationId="5af86795--pubN111452" collective="false">
      <constraints>
        <constraint type="max" value="1" field="selections" scope="roster" shared="true" id="40bd-348a-7bf1-9094" percentValue="false" includeChildSelections="true" includeChildForces="false"/>
      </constraints>
      <profiles>
        <profile name="Last Memory of Yuranthos" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item" hidden="false" id="7f42-137f-9a20-1fec">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Psyker only. Increases the bearer ML by 1.Do not generate an additional psychic power for this bonus Mastery Level. Instead, the Psyker knows the Sunburst psychic power from the Pyromancy Discipline in addition to any other powers he knows. The Psyker can choose to manifest Sunburst with an increased range, though this will have an increased Warp Charge cost. If you wish to increase its range to 12&quot;, Sunburst has a Warp Charge cost of 2; if you wish to increase its range to 18&quot;, Sunburst has a WC cost of 3 - declare the range of the power you are attempting to manifest before rolling. If the Psyker suffers Perils of the Warp when attempting to manifest this power with an increased range, he is removed from play as a casualty - do not roll on the Perils of the Warp table.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <costs>
        <cost name="pts" typeId="points" value="30"/>
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Legacy of Ruin: Auloth the Primordial Iterator" hidden="false" id="cb22-b9ca-08f9-6915" collective="false">
      <constraints>
        <constraint type="max" value="1" field="selections" scope="roster" shared="true" id="112e-72f1-7840-f18c" percentValue="false" includeChildSelections="true" includeChildForces="false"/>
        <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="9358-ed6e-592e-447e" percentValue="false" includeChildSelections="false" includeChildForces="false"/>
      </constraints>
      <profiles>
        <profile name="Legacy of Ruin: Auloth the Primordial Iterator" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item" hidden="false" id="79f9-1ab6-01b7-3082">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Has Fear. All weapons have Pinning. All friendly units with an Icon of wrath within 12&quot; have the fear and Feel no Pain special rules.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <infoLinks>
        <infoLink name="Daemonic Possession" id="6597-6275-6407-7f95" hidden="false" targetId="2725-7631-dcea-bad6" type="profile"/>
        <infoLink name="Fear" id="6a79-144a-961f-9714" hidden="false" targetId="280d-1a0c-5916-3012" type="rule"/>
      </infoLinks>
      <costs>
        <cost name="pts" typeId="points" value="0"/>
      </costs>
    </selectionEntry>
