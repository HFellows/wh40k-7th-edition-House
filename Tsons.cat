      <constraints>
        <constraint type="max" value="1" field="selections" scope="roster" shared="true" id="2213-58f7-862a-b755" percentValue="false" includeChildSelections="true" includeChildForces="false"/>
        <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="379a-4d1e-0db5-5c88" percentValue="false" includeChildSelections="false" includeChildForces="false"/>
      </constraints>
      <profiles>
        <profile name="Legacies of Ruin: Fourth Quadrant Rebellion" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item" hidden="false" id="5100-4cde-17a2-5d07">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Friendly units of Cultists within 12&quot; are Fearless. When the vehicle has 1 Hull Point remaining, it gains a 4+ Invunerable save.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <costs>
        <cost name="pts" typeId="points" value="0"/>
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Legacy of Ruin: Last of the Forge" hidden="true" id="1f44-6c1a-1283-8132" collective="false">
