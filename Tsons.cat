      <rules>
        <rule name="Relic Hunters" id="08b0-6ebb-6445-68e5" hidden="false">
          <description>Models with this specail rule can re-roll all failed To Hit rolls in close combat against enemy models equipped with a relic (or their Faction&apos;s equivalent e.g. Chaos Artefacts).</description>
