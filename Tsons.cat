                  </characteristics>
                </profile>
              </profiles>
              <rules>
                <rule name="Capacitor Fire" id="fdac-69b4-5a4c-d9f7" hidden="false">
                  <description>If the vindicator has not moved this turn, the laser destroyer array shots are then Ordnance 2, Twin-linked.</description>
                </rule>
                <rule name="Overcharged Fire" id="7ce5-0ee5-a91e-99ef" hidden="false">
                  <description>The player may declare an overcharged fire if the vehicle has not moved this turn. The Laser Destroyer array counts as Ordnance 3, Twin-linked. The player rolls a D6 after shooting the array, and loses a Hull Point (no save allowed) on the roll of a 1.</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
            </selectionEntry>
