      <constraints>
        <constraint type="max" value="1" field="selections" scope="roster" shared="true" id="8a52-08fa-4918-6dcf" percentValue="false" includeChildSelections="true" includeChildForces="false"/>
        <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="9771-047e-4017-8ad4" percentValue="false" includeChildSelections="false" includeChildForces="false"/>
