    <selectionEntry type="model" import="true" name="Heldrake" hidden="false" id="a41e-41be-54b3-36d3" page="0" collective="false">
      <profiles>
        <profile name="Heldrake" typeId="3a08-ea03-a598-8615" typeName="Flyer" hidden="false" id="0d51-e864-51bb-e64a">
          <characteristics>
            <characteristic name="BS" typeId="9878-e3f6-b7b4-7225">3</characteristic>
            <characteristic name="Front" typeId="3a4e-bc1d-4a12-7176">12</characteristic>
            <characteristic name="Side" typeId="d12e-7bdb-191c-4849">12</characteristic>
            <characteristic name="Rear" typeId="a4cb-791a-6a75-4e4a">10</characteristic>
            <characteristic name="HP" typeId="93e6-d4b1-28a8-944b">3</characteristic>
            <characteristic name="Type" typeId="eb65-838c-8eaa-8b5d">Vehicle (Flyer, Hover)</characteristic>
            <characteristic name="Combat Role" typeId="d477-c087-173f-9f1c">Attack</characteristic>
            <characteristic name="Pursuit" typeId="e04d-332e-8b52-0071">2</characteristic>
            <characteristic name="Agility" typeId="ae34-f5c0-19af-4883">4</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule name="Aerial Strike" id="4704-9dda-ffdb-1b03" hidden="false">
          <description>In a Dogfight, a Heldrake which is tailing an opponent at a range of up to 12&quot; in the Attack sub-phase can make an Aerial Strike in addition to its other attacks. The Aerial Strike inflicts a S7 AP2 hit.</description>
        </rule>
        <rule name="Meteroric Descent" id="134b-7ba7-bc6c-c135" hidden="false" page="0">
          <description>Heldrake has the Vector Strike special rule while zooming. these hits are at S7</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink name="Daemonic Possession" id="5a0b-da65-0edb-f9ab" hidden="false" targetId="2725-7631-dcea-bad6" type="profile"/>
