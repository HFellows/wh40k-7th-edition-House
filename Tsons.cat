    <selectionEntry type="upgrade" import="true" name="The Black Mace" hidden="false" id="19f8-f35e-6bd7-7b92" page="0" collective="false">
      <constraints>
        <constraint type="max" value="1" field="selections" scope="roster" shared="true" id="1f0b-f030-6979-6f8d" percentValue="false" includeChildSelections="true" includeChildForces="false"/>
      </constraints>
      <profiles>
        <profile name="The Black Mace" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon" hidden="false" id="e990-f71e-0537-3611">
          <characteristics>
            <characteristic name="Range" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">-</characteristic>
            <characteristic name="Strength" typeId="a6383362-5aa8-4ff0-b1d0-00e059fc9d45">User</characteristic>
            <characteristic name="AP" typeId="6abee736-f8d3-498e-97ac-a5c68445609f">4</characteristic>
            <characteristic name="Type" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Melee, Cursed, Daemon Weapon, Fleshbane</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule name="Cursed" id="5252-9871-16a6-268d" hidden="false">
          <description>When a model suffers an unsaved wound, it must take a Toughness test. If it fails, remove the model with no saves allowed.

At the end of a phase that the Black Mace caused an unsaved wound, all non vehicle models within 3&quot; must take a toughness test. If failed, remove with no saves allowed.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink name="Daemon Weapon" id="025f-6055-4907-ab8f" hidden="false" targetId="fbe9-b5a1-1cc1-0837" type="rule"/>
        <infoLink name="Fleshbane" id="9c2f-f161-3ade-2412" hidden="false" targetId="3897-5e71-1b57-57ba" type="rule"/>
      </infoLinks>
      <costs>
        <cost name="pts" typeId="points" value="45"/>
      </costs>
    </selectionEntry>
