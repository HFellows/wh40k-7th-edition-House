    <selectionEntry type="upgrade" import="true" name="Legacy of Ruin: Blood of Mackan" hidden="false" id="7769-403b-fe84-ab5d" collective="false">
      <constraints>
        <constraint type="max" value="1" field="selections" scope="roster" shared="true" id="d413-4fee-84e7-6402" percentValue="false" includeChildSelections="true" includeChildForces="false"/>
        <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="ccbf-a4bf-19d3-2fd8" percentValue="false" includeChildSelections="false" includeChildForces="false"/>
      </constraints>
      <profiles>
        <profile name="Legacies of Ruin: Blood of Mackan" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item" hidden="false" id="ff10-553e-e79b-d523">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">The vehicle gains Preferred Enemy (Blood Angels) and doesn&apos;t treat defence lines and barricades as Dangerous Terrain.  If the vehicle is fitted with Destroyer Blades, the damage inflicted from a Tank Shock attack (after Death or Glory) has an AP value equal to the number of Hull Points left (with over 6 being &quot;-&quot;)</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <costs>
        <cost name="pts" typeId="points" value="0"/>
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Legacy of Ruin: Death of Kasyr Lutien" hidden="false" id="3061-5620-b5aa-4271" collective="false">
      <constraints>
        <constraint type="max" value="1" field="selections" scope="roster" shared="true" id="062b-e517-fbe2-32dc" percentValue="false" includeChildSelections="true" includeChildForces="false"/>
        <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="04ac-d1dd-8a14-b1c7" percentValue="false" includeChildSelections="false" includeChildForces="false"/>
      </constraints>
      <profiles>
        <profile name="Legacies of Ruin: Death of Kasyr Lutien" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item" hidden="false" id="1786-d12d-3663-469e">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Vehicle gains the fear special rule. In addition, when psychic tests to use Maelific powers are made by friendly psykers within 12&quot;, one D6 may be re-rolled for every Hull Point remaining.   If the test is failed, the vehicle suffers a penetrating hit in addition to the normal psyker consquences.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <costs>
        <cost name="pts" typeId="points" value="0"/>
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Legacy of Ruin: First War of Armageddon" hidden="false" id="b4b8-fb59-7631-b06d" collective="false">
      <constraints>
        <constraint type="max" value="1" field="selections" scope="roster" shared="true" id="1d55-ad8d-c0d8-2603" percentValue="false" includeChildSelections="true" includeChildForces="false"/>
        <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="4f3b-415c-0343-420c" percentValue="false" includeChildSelections="false" includeChildForces="false"/>
      </constraints>
      <profiles>
        <profile name="Legacies of Ruin: First War of Armageddon" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item" hidden="false" id="fb85-5543-e6fe-eb46">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Daemonic Saves made by a Friendly Daemon of Khorne within 6&quot; are improved by 1, to a maximum of 2+.  Has fear when attacked by Astra Militarum.</characteristic>
          </characteristics>
        </profile>
      </profiles>
