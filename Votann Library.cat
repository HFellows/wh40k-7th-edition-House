              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Warp Charge 1. Select a friendly Unit within 12&quot; of this model. It gains Twin-linked with all of its Weapons. In addition it can reroll 1s to wound</characteristic>
              </characteristics>
            </profile>
          </profiles>
