      <rules>
        <rule name="Ironkin Assistant" id="5ce7-71d9-926b-7d41" hidden="false">
          <description>Models with this rule make 1 additional attack at initiative 1 when they fight</description>
        </rule>
        <rule name="Brokhyr&apos;s Guild" id="8770-8762-71ea-ade7" hidden="false">
          <description>At the end of each movement phase, this unit can repair one friendly vehicle or exo frame model with in 6&quot;. the model regians d3 wounds. each model can be repaired once each turn.</description>
        </rule>
        <rule name="Multi spectral visor " id="af9d-0f51-45b9-af7d" hidden="false">
          <description>At the end of the movement phase you can select 1 friendly Votann troop or Vehicle. during the next shooting phase it reduces cover by 1</description>
        </rule>
        <rule name="Steady Advanced" id="78a8-c36e-5e5f-91c9" hidden="false">
          <description>Auto advances 3&quot; (6&quot; if a unit with this rule in with in 12&quot; of and objective) , ignores the penalties to movement from dangerous terrain when advancing and Charging</description>
        </rule>
      </rules>
