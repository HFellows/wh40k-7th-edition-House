          </constraints>
          <profiles>
            <profile name="Null Vortex" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item" hidden="false" id="f32f-fa70-efc5-90c9">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Warp Charge 1. Target an enemy unit within 12&quot; of this model. That unit can not use Invul Saves for the rest of the turn.</characteristic>
