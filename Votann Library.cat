              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Warp Charge 1. Target Friendly non-vehicle unit with in 12&quot; they gain +1 Toughness and FNP 6+ until the start of your next magic phase</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Grudgeprye" hidden="false" id="63f5-629b-3518-ca49">
