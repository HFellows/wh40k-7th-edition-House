              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Warp Charge 2. Pick an enemy non-vehicle unit with in 18&quot;. Roll 5 dice, 10 dice if the unit contains more than 14 models, on a 4+ that units suffers a wound which ignores all saves</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Crushing Contempt" hidden="false" id="9274-2c38-38f4-c5e2">
          <constraints>
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="ca6f-80e3-abd8-0a1a"/>
          </constraints>
          <profiles>
            <profile name="Crushing Contempt" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item" hidden="false" id="5dfe-34c9-cb58-ceeb">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Warp Charge 1. Pick an Enemy Unit with in 18&quot; of this model. Roll 3d6, if the resualt is equal to or higher than their leadership they gain -1 bs, ws, I, and A (minimum 1) until your next magic phase</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Fortify" hidden="false" id="f918-f049-690d-d322">
