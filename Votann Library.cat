  <sharedRules>
    <rule name="Steady Advanced" id="3296-58e7-4b42-6644" hidden="false">
      <description>Auto advances 3&quot; (6&quot; if a unit with this rule in with in 12&quot; of and objective) , ignores the penalties to movement from dangerous terrain when advancing</description>
    </rule>
    <rule name="Refract " id="5b89-fa8a-46fc-34a1" hidden="false">
      <description>On a Wound of a 6+ the unit takes 2 additional wounds. these wounds do not generate more wounds</description>
    </rule>
    <rule name="Magna-rail" id="e8a6-4386-2da0-eaf6" hidden="false">
      <description>On a wound of a 6+ the opponent may not take Invul saves</description>
    </rule>
  </sharedRules>
