      </constraints>
      <profiles>
        <profile name="Command and Control Node" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item" hidden="false" id="1c1c-87df-44d2-2034">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">If a model with this wargear does not shoot in the Shooting phase, all shooting attacks made by other models in his unit re-roll failed To Hit rolls until the end of the phase. This cannot be used when firing Overwatch. The C&amp;C Node can be used at the same time as a Multi-spectrum Sensor Suite.</characteristic>
          </characteristics>
        </profile>
      </profiles>
