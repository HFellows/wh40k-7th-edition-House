            <constraint type="min" value="3" field="selections" scope="parent" shared="false" id="01ba-3f2e-ecc3-f706" percentValue="false" includeChildSelections="false" includeChildForces="false"/>
            <constraint type="max" value="3" field="selections" scope="parent" shared="false" id="203b-1c89-184f-8219" percentValue="false" includeChildSelections="false" includeChildForces="false"/>
          </constraints>
          <entryLinks>
