          <profiles>
            <profile name="Vigilance Defence System" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item" hidden="false" id="6b16-3a5f-4898-d543" publicationId="24a0-49b6-pubN79550">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">The vigilance defence system comprises two smart missile systems and two twin-linked burst cannon which may be fired normally. In addition, these weapons can be used to make Overwatch attacks at BS2 contrary to the usual rules for Gargantuan Creatures.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <infoLinks>
