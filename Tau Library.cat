            <cost name="pts" typeId="points" value="0"/>
          </costs>
        </selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Barrier Shield Generator" hidden="false" id="6814-0cce-b4ef-dc80" collective="false">
          <constraints>
            <constraint type="min" value="1" field="selections" scope="parent" shared="false" id="fb21-60fd-f195-8298" percentValue="false" includeChildSelections="false" includeChildForces="false"/>
            <constraint type="max" value="1" field="selections" scope="parent" shared="false" id="6805-ca79-deab-b4ad" percentValue="false" includeChildSelections="false" includeChildForces="false"/>
          </constraints>
          <profiles>
            <profile name="Barrier Shield Generator" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item" hidden="false" id="066a-4617-11c2-18a8" publicationId="24a0-49b6-pubN99881">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">The barrier shield provides a 5+ invulnerable save, increasing to 4+ save against Shooting attacks. When a model with a barrier shield is struck by a Destroyer attack and &apos;Deathblow&apos; result occurs, the amount of wounds inflicted is halved but the shield stops working until the start of the controlling player&apos;s next turn.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="0"/>
          </costs>
        </selectionEntry>
