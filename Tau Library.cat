      <rules>
        <rule name="Fight on Foot" id="aa29-ad79-2d1f-aa63" hidden="false">
          <description>Can only join Breacher Teams, Strike Teams or Pathfinder Teams.</description>
        </rule>
        <rule name="Fighting Retreat" id="0b7b-1bf0-d144-cd70" hidden="false">
          <description>Darkstrider, and his unit, can consolidate D6 in any direction after firing Overwatch (before rolls for charge range are made).</description>
        </rule>
