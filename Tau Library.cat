      </constraints>
      <profiles>
        <profile name="Coldstar Battlesuit" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item" hidden="false" id="f174-ecdd-cf28-69fa">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">If the Commander has any Drones, they form a unit with him while he is Gliding. When he is Swooping, the Drones are removed from the battlefield. If he is slain whilst Swooping, his Drones are destroyed. If a Swooping Commander changes flight mode (or is grounded), his surviving Drones are immediately placed on the battlefield in unit coherency with him.</characteristic>
          </characteristics>
        </profile>
      </profiles>
