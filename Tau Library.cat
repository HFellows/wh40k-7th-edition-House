      <profiles>
        <profile name="Failsafe Detonator" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item" hidden="false" id="3890-26e9-7da4-55e6">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">If this model dies in the Assault phase, centre the large blast marker over him immediatetly before removing him. All units, friend and foe, suffer a number of S5 Ap- hits equal to the number of models from their unit that are at least partially under the template. Unsaved wounds inflicted this way count towards determining the assault result.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <costs>
        <cost name="pts" typeId="points" value="10"/>
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Farsight Enclaves" hidden="false" id="1b69-35ca-cb38-e608" publicationId="24a0-49b6-pubN65836" collective="false">
      <constraints>
        <constraint type="max" value="1" field="selections" scope="force" shared="false" id="a6d9-08e7-344e-f82a" percentValue="false" includeChildSelections="false" includeChildForces="false"/>
      </constraints>
      <rules>
        <rule name="Battlesuit Spearhead" id="2714-9fac-0eb2-d9f9" hidden="false" publicationId="24a0-49b6-pubN65836" page="85">
          <description>In a Farsight Enclaves Detachment or Formation, XV8 Crisis Battlesuits are Troops choices instead of Elites choices</description>
        </rule>
        <rule name="Ork Hunters" id="b941-f972-849e-357c" hidden="false" publicationId="24a0-49b6-pubN65836" page="85">
          <description>Units in a Farsight Enclaves Detachment or Formation have the Preferred Enemy (Orks) special rule when making close combat attacks.</description>
        </rule>
        <rule name="Ta&apos;lissera Bond" id="de0e-7ad2-bd09-6a27" hidden="false" publicationId="24a0-49b6-pubN65836" page="85">
          <description>Units in a Farsight Enclaves Detachment or Formation that have the option to take the Bonding Knife Ritual special rule must do so.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink name="Preferred Enemy" id="5d6c-14e6-9b9b-9344" hidden="false" targetId="f217-b311-e5b1-c8c7" type="rule">
          <modifiers>
            <modifier type="append" value=" (Orks in Close Combat)" field="name"/>
          </modifiers>
        </infoLink>
      </infoLinks>
      <costs>
        <cost name="pts" typeId="points" value="0"/>
      </costs>
    </selectionEntry>
