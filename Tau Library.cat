            <characteristic name="Type" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Melee, Armourbane, Blind, Power Outage</characteristic>
          </characteristics>
        </profile>
        <profile name="Fusion Blades" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item" hidden="false" id="c72c-d5fc-b996-9284">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Commanders with twin-linked fusion blaster only. Replace one twin-linked Fusion Blaster&apos;s profile with the Fusion Blades ranged and melee profiles.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule name="Power Outage" id="5425-3361-4bff-0e7d" hidden="false">
          <description>Roll a D6 at the end of every Assault phase in which the Fusion Blades used their Melee profile. On the roll of a 1, neither the Shooting nor Melee profile may be used for the rest of the game.</description>
        </rule>
      </rules>
      <costs>
        <cost name="pts" typeId="points" value="30"/>
      </costs>
    </selectionEntry>
