                <profile name="Conversion Beamer (Details)" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item" hidden="false" id="cbc6-8d47-c599-1209">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">When firing the conversion beamer, place the blast marker over a target within 72&quot; and then roll for scatter. Once the final location of the blast marker has been determined, measure the distance from the firer to the center of the blast marker and consult the chart below to determine the effect. If this distance is greater than 72&quot;, the shot mises. If it is not clear which of the profiles to use, the controlling player can choose.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
