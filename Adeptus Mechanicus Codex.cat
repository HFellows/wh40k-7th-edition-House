        <profile name="Conversion Beamer (18&quot; - 42&quot;)" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon" hidden="false" id="e5e5-c875-a9e8-2208">
          <characteristics>
