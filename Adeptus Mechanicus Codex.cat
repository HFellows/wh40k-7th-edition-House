    </profile>
    <profile name="Radium Pistol" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon" hidden="false" id="e1c3-fcf3-6c80-58df" publicationId="2301-1cab-pubN65537" page="74">
      <characteristics>
