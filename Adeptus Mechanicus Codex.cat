        <entryLink import="true" name="Arlatax Battle-Automata " hidden="false" id="f7b5-22a1-70da-47e7" type="selectionEntry" targetId="37e5-93a6-a63d-2052">
          <constraints>
            <constraint type="min" value="1" field="selections" scope="parent" shared="true" id="2c0a-508c-19d4-682a"/>
            <constraint type="min" value="3" field="selections" scope="parent" shared="true" id="318a-6c00-2663-1a3e"/>
          </constraints>
        </entryLink>
        <entryLink import="true" name="Cybernetica Automata" hidden="false" id="a6a4-a7c9-1e67-c4ce" type="selectionEntry" targetId="6385-930f-9114-9d3d">
          <constraints>
            <constraint type="min" value="1" field="selections" scope="parent" shared="true" id="eb1b-9d6b-d540-dff2" includeChildSelections="false"/>
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="c05f-3584-22ee-1aec" includeChildSelections="false"/>
          </constraints>
          <rules>
            <rule name="Programmed Behavior" id="9423-5ced-37c4-3ed8" hidden="false">
              <description>During both the controlling player’s Shooting phase and the Assault phase, a Cybernetica-Automata unit must attempt a Shooting Attack or Charge if there is an enemy unit within range, and must target the closest enemy unit possible that is within its line of sight and is a valid target for a Shooting Attack or Charge. If two or more targets are equally close then the controlling player chooses which will be the target of a Shooting Attack or Charge.</description>
            </rule>
            <rule name="Pre-set Kill Limit" id="ef8d-03b2-c8ee-1b4c" hidden="false">
              <description>Cybernetica-Automata units may not fire overwatch.</description>
            </rule>
            <rule name="For The Machine Is Immortal" id="7d59-93de-f214-8b5c" hidden="false">
              <description>Successful Wounds inflicted by attacks with the Poisoned or Fleshbane special rules must be re-rolled against models of the Cybernetica-Automata Unit Type.</description>
            </rule>
            <rule name="The Zeroth Law" id="b889-271d-756b-f1e3" hidden="false">
              <description>No model that is not also of the Cybernetica-Automata Unit Type may join a unit that includes an Cybernetica-Automata model unless otherwise specified.</description>
            </rule>
          </rules>
        </entryLink>
      </entryLinks>
      <categoryLinks>
        <categoryLink targetId="c274d0b0-5866-44bc-9810-91c136ae7438" id="22a5-1cbe-cf9c-cf94" primary="true" name="Fast Attack"/>
      </categoryLinks>
    </selectionEntry>
