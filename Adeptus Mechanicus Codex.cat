        <characteristic name="Type" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Melee, Transonic</characteristic>
      </characteristics>
    </profile>
    <profile name="Taser lance" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon" hidden="false" id="7ea0-c7f1-e92f-ec0c" publicationId="2301-1cab-pubN65537" page="75">
