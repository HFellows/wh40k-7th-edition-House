    <selectionEntry type="upgrade" import="true" name="Vultarax Stratos-Automata Squadron" hidden="false" id="15a3-4056-3893-5e55">
      <entryLinks>
        <entryLink import="true" name="Vultarax Stratos" hidden="false" id="3b7b-e9b2-ad17-a37c" type="selectionEntry" targetId="811e-9869-e0fb-c318">
          <constraints>
            <constraint type="min" value="1" field="selections" scope="parent" shared="true" id="7f19-1166-a443-292a"/>
            <constraint type="max" value="4" field="selections" scope="parent" shared="true" id="7f4b-eb00-9f25-bc64"/>
          </constraints>
        </entryLink>
        <entryLink import="true" name="Cybernetica Automata" hidden="false" id="922d-01aa-6cdb-5bc7" type="selectionEntry" targetId="6385-930f-9114-9d3d">
          <constraints>
            <constraint type="min" value="1" field="selections" scope="parent" shared="true" id="642b-8537-9acf-46c9" includeChildSelections="false"/>
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="e39c-3f09-c2bb-f4b7" includeChildSelections="false"/>
          </constraints>
          <rules>
            <rule name="Programmed Behavior" id="d964-8ed0-146a-8d15" hidden="false">
              <description>During both the controlling player’s Shooting phase and the Assault phase, a Cybernetica-Automata unit must attempt a Shooting Attack or Charge if there is an enemy unit within range, and must target the closest enemy unit possible that is within its line of sight and is a valid target for a Shooting Attack or Charge. If two or more targets are equally close then the controlling player chooses which will be the target of a Shooting Attack or Charge.</description>
            </rule>
            <rule name="Pre-set Kill Limit" id="f060-5733-b1ea-b383" hidden="false">
              <description>Cybernetica-Automata units may not fire overwatch.</description>
            </rule>
            <rule name="For The Machine Is Immortal" id="e72a-7f34-8c89-a54c" hidden="false">
              <description>Successful Wounds inflicted by attacks with the Poisoned or Fleshbane special rules must be re-rolled against models of the Cybernetica-Automata Unit Type.</description>
            </rule>
            <rule name="The Zeroth Law" id="cbd1-9c16-def3-f0f5" hidden="false">
              <description>No model that is not also of the Cybernetica-Automata Unit Type may join a unit that includes an Cybernetica-Automata model unless otherwise specified.</description>
            </rule>
          </rules>
        </entryLink>
      </entryLinks>
      <infoLinks>
        <infoLink name="Doctrina Imperatives" id="6b94-612d-e6cf-a304" hidden="false" type="rule" targetId="a816-e86a-b5d0-8037"/>
      </infoLinks>
    </selectionEntry>
