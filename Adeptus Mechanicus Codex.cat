            <constraint type="max" value="4" field="selections" scope="parent" shared="true" id="f43a-2c42-c6b3-3731"/>
          </constraints>
        </entryLink>
        <entryLink import="true" name="Cybernetica Automata" hidden="false" id="240a-8723-6357-2b3e" type="selectionEntry" targetId="6385-930f-9114-9d3d">
          <constraints>
            <constraint type="min" value="1" field="selections" scope="parent" shared="true" id="79e2-fc49-2e43-8ef8" includeChildSelections="false"/>
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="5c7d-0bd2-45c0-c130" includeChildSelections="false"/>
          </constraints>
          <rules>
            <rule name="Programmed Behavior" id="8d1f-c07d-6304-2739" hidden="false">
              <description>During both the controlling player’s Shooting phase and the Assault phase, a Cybernetica-Automata unit must attempt a Shooting Attack or Charge if there is an enemy unit within range, and must target the closest enemy unit possible that is within its line of sight and is a valid target for a Shooting Attack or Charge. If two or more targets are equally close then the controlling player chooses which will be the target of a Shooting Attack or Charge.</description>
            </rule>
            <rule name="Pre-set Kill Limit" id="c918-a7da-cc17-9f92" hidden="false">
              <description>Cybernetica-Automata units may not fire overwatch.</description>
            </rule>
            <rule name="For The Machine Is Immortal" id="063e-995b-67af-cbfa" hidden="false">
              <description>Successful Wounds inflicted by attacks with the Poisoned or Fleshbane special rules must be re-rolled against models of the Cybernetica-Automata Unit Type.</description>
            </rule>
            <rule name="The Zeroth Law" id="9edd-7290-7f7f-4a94" hidden="false">
              <description>No model that is not also of the Cybernetica-Automata Unit Type may join a unit that includes an Cybernetica-Automata model unless otherwise specified.</description>
            </rule>
          </rules>
        </entryLink>
      </entryLinks>
      <infoLinks>
        <infoLink name="Canticles of the Omnissiah (CotO)" id="33d1-0c38-04f9-1815" hidden="false" type="rule" targetId="2624-ddf9-eb70-e0f9"/>
      </infoLinks>
    </selectionEntry>
