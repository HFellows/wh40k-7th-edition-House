          <constraints>
            <constraint type="max" value="6" field="selections" scope="parent" shared="true" id="d510-8408-df80-7575"/>
            <constraint type="min" value="1" field="selections" scope="parent" shared="true" id="992d-b445-434d-257e" includeChildSelections="false"/>
          </constraints>
          <entryLinks>
            <entryLink import="true" name="Cybernetica Automata" hidden="false" id="b706-3d08-cf56-b91d" type="selectionEntry" targetId="6385-930f-9114-9d3d">
              <constraints>
                <constraint type="min" value="1" field="selections" scope="parent" shared="true" id="2c96-8e6f-998c-57f7-min" includeChildSelections="false"/>
                <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="2c96-8e6f-998c-57f7-max" includeChildSelections="false"/>
              </constraints>
              <rules>
                <rule name="Programmed Behavior" id="c038-0135-e133-707a" hidden="false">
                  <description>During both the controlling player’s Shooting phase and the Assault phase, a Cybernetica-Automata unit must attempt a Shooting Attack or Charge if there is an enemy unit within range, and must target the closest enemy unit possible that is within its line of sight and is a valid target for a Shooting Attack or Charge. If two or more targets are equally close then the controlling player chooses which will be the target of a Shooting Attack or Charge.</description>
                </rule>
                <rule name="Pre-set Kill Limit" id="1358-b6c4-953a-eb03" hidden="false">
                  <description>Cybernetica-Automata units may not fire overwatch.</description>
                </rule>
                <rule name="For The Machine Is Immortal" id="defe-bee1-7984-121f" hidden="false">
                  <description>Successful Wounds inflicted by attacks with the Poisoned or Fleshbane special rules must be re-rolled against models of the Cybernetica-Automata Unit Type.</description>
                </rule>
                <rule name="The Zeroth Law" id="1a44-9675-76e4-8283" hidden="false">
                  <description>No model that is not also of the Cybernetica-Automata Unit Type may join a unit that includes an Cybernetica-Automata model unless otherwise specified.</description>
                </rule>
              </rules>
            </entryLink>
          </entryLinks>
        </entryLink>
      </entryLinks>
      <selectionEntryGroups>
        <selectionEntryGroup name="1 in 3 may exchange Lightning Gun for Irad Cleanser" id="3ffe-438d-d2a8-8d7f" hidden="false" collective="false" import="true" defaultSelectionEntryId="4f2a-53f2-7067-b3ce">
