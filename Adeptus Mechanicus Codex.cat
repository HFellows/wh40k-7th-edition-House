            <constraint type="max" value="1" field="selections" scope="parent" shared="false" id="a779-34bc-14ce-c58d" percentValue="false" includeChildSelections="false" includeChildForces="false"/>
            <constraint type="max" value="1" field="selections" scope="roster" shared="true" id="d3b0-574e-47ad-b894" percentValue="false" includeChildSelections="true" includeChildForces="false"/>
          </constraints>
          <profiles>
            <profile name="The Skull of Elder Nikola" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item" hidden="false" id="ef53-0f85-7232-9623" publicationId="2301-1cab-pubN65537" page="77">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">May use once per game instead of shooting. Each vehicle within XD6 inches suffers a Haywire hit, where X is the current turn number.</characteristic>
              </characteristics>
            </profile>
          </profiles>
