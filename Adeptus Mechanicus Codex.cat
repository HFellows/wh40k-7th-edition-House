                <rule name="Field Repairs (It Will Not Die)" id="0cd5-a7da-c163-4945" hidden="false" publicationId="2301-1cab-pubN65537" page="75">
                  <description>At end of your turn, roll for each model with this rule that&apos;s missing a Wound or Hull Point.  On 5+ it regains one. (BRB 2014 p167)</description>
                </rule>
              </rules>
