    <selectionEntry type="unit" import="true" name="Castellax Battle-Maniple" hidden="false" id="7552-6492-c905-e6b0">
      <entryLinks>
        <entryLink import="true" name="Castellax" hidden="false" id="2844-b06e-de3c-613e" type="selectionEntry" targetId="0014-09db-fd27-1187">
