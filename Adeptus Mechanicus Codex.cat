    <profile name="Radium Carbine" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon" hidden="false" id="6263-cd7b-aecd-9361" publicationId="2301-1cab-pubN65537" page="74">
