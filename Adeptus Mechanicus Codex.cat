    <selectionEntry type="unit" import="true" name="Tech-Priest Dominus" hidden="false" id="50ef-62fb-a144-38bf" publicationId="4fe1-8588-pubN65537" page="59" collective="false">
      <rules>
        <rule name="Master of the Machines" id="3791-c56a-f0b7-1cc7" hidden="false" publicationId="4fe1-8588-pubN65537" page="59">
          <description>Instead of firing one of his weapons, and rolling 2+ in a D6, a Tech-Priest Dominus may instead:
· Restore a HP, or repair a Weapon Destroyed or Immobilised result to a single friendly vehicle in base contact or embarked upon. OR
· Restore a Wound lost earlier in the battle to himself, or to any model of Skitarii or Cult Mechanicus faction in his unit.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink name="Canticles of the Omnissiah (CotO)" id="976f-cb82-6a0e-19a2" hidden="false" targetId="2624-ddf9-eb70-e0f9" type="rule"/>
        <infoLink name="Tech-Priest Dominus" id="9124-f52c-9147-98be" hidden="false" targetId="c1d2-bf5a-1075-38c3" type="profile"/>
        <infoLink name="Independent Character" id="39eb-298e-ed17-7305" hidden="false" targetId="ef3b-09c6-4024-cd37" type="rule"/>
        <infoLink name="Feel No Pain" id="4702-3197-0228-ad2a" hidden="false" targetId="3c7d-11d6-e265-abb4" type="rule"/>
        <infoLink name="Relentless" id="4746-4bde-5634-52f6" hidden="false" targetId="7674-690c-ab59-1444" type="rule"/>
