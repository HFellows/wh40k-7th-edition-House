    <rule name="Orders: Get Back in the Fight!" id="f1f4-560c-4e2c-3407" hidden="false" publicationId="2be8d152--pubN72426" page="0"/>
    <rule name="Orders: Forwards, for the Emperor!" id="2f80-682c-8107-ae99" hidden="false" publicationId="2be8d152--pubN72426" page="0"/>
