      <selectionEntryGroups>
        <selectionEntryGroup name="Main Weapon" id="0d47-a244-0de7-de72" hidden="false">
          <constraints>
            <constraint id="3554-2174-9033-4530" field="selections" scope="parent" shared="true" type="min" value="1"/>
            <constraint id="ec88-54e7-7022-c56f" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <selectionEntries>
            <selectionEntry name="Irradiation Blaster" id="bdf9-9046-b13a-acfa" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="15c7-5698-8333-8f7f" field="selections" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="pts" typeId="points" value="40"/>
              </costs>
              <infoLinks>
                <infoLink name="Fleshbane" id="3e7e-c08c-892a-d68b" hidden="false" targetId="3897-5e71-1b57-57ba" type="rule"/>
              </infoLinks>
              <profiles>
                <profile name="Irradiation Blaster (Dispersed)" id="cfe4-33cc-be9f-da95" hidden="false" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
                  <characteristics>
                    <characteristic name="Range" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">Hellstorm</characteristic>
                    <characteristic name="Strength" typeId="a6383362-5aa8-4ff0-b1d0-00e059fc9d45">2</characteristic>
                    <characteristic name="AP" typeId="6abee736-f8d3-498e-97ac-a5c68445609f">5</characteristic>
                    <characteristic name="Type" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Heavy 1, Fleshbane, Rad-phage</characteristic>
                  </characteristics>
                </profile>
                <profile name="Irradiation Blaster (Focused)" id="ca40-5b95-2ea5-24c2" hidden="false" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
                  <characteristics>
                    <characteristic name="Range" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">16&quot;</characteristic>
                    <characteristic name="Strength" typeId="a6383362-5aa8-4ff0-b1d0-00e059fc9d45">7</characteristic>
                    <characteristic name="AP" typeId="6abee736-f8d3-498e-97ac-a5c68445609f">3</characteristic>
                    <characteristic name="Type" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Heavy 1, Fleshbane, Rad-phage, Radiation Beam</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <rules>
                <rule name="Radiation Beam" id="cce4-8a2d-f604-a4a0" hidden="false">
                  <description>draw a 1mm wide line from the end of the gun barrel up to the listed range of the weapon. All friendly models (friend or foe) suffer a hit from the weapon, expect models with fly. Units with any models in the beam receive a number of hit equal to the number of their models caught in the path. If a piece of terrain, vehicle, or Model with 6 or more starting wounds is hit by the beam the beam stops causing d3 hits against the model instead of 1. If a transport suffers a penetrating hit the occupants suffer d6 str 2 hits with fleshbane in addition to the other effects.</description>
                </rule>
                <rule name="Rad-Phage" id="8eba-0883-db63-8adb" hidden="false">
                  <description>A model which loses one or more Wounds to an attack with this special rule and survives has its Toughness value reduced by -1 for the rest of the battle. This effect is not cumulative with other attacks using the Rad-phage special rule, but can be stacked with other special rules that also reduce the Toughness Characteristic of the target. Note that this special rule can never reduce a model to a Toughness value of less than 1.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry name="Lightning Cannon" id="764b-8ab4-e629-90ca" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="2df1-8fb8-fd35-e3c1" field="selections" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <infoLinks>
                <infoLink name="Rending" id="78ad-fb4d-022b-cef4" hidden="false" targetId="6a76-59d1-822c-59c9" type="rule"/>
                <infoLink name="Shred" id="1531-7cbe-79fc-a1f1" hidden="false" targetId="5770-35c6-7341-5527" type="rule"/>
              </infoLinks>
              <profiles>
                <profile name="Lightning Cannon" id="3165-744a-89c1-b9e5" hidden="false" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
                  <characteristics>
                    <characteristic name="Range" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">36&quot;</characteristic>
                    <characteristic name="Strength" typeId="a6383362-5aa8-4ff0-b1d0-00e059fc9d45">7</characteristic>
                    <characteristic name="AP" typeId="6abee736-f8d3-498e-97ac-a5c68445609f">3</characteristic>
                    <characteristic name="Type" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Heavy 1, Large Blast, Rending, Shred, Exoshock</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <rules>
                <rule name="Exoshock" id="63ec-3063-a4d6-54bd" hidden="false">
                  <description>If this weapons successfully scores a penetrating hit on a target, roll a d6. on a 6 that target suffers another penetrating hit that ignores cover and does not gain any special rules.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry name="Pulsar-Fusil" id="a7ea-8104-3678-15e3" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="ac27-5550-1096-dca4" field="selections" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="pts" typeId="points" value="20"/>
