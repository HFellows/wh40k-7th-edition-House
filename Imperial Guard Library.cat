    <rule name="Accidental Detonation" id="d67348b1-da45-e710-d628-5c4eb3dcce53" hidden="false" publicationId="2be8d152--pubN100633" page="215"/>
    <rule name="Accurate Bombardment" id="a328a20e-5867-9cfc-ed82-e8e2468be31b" hidden="false" publicationId="2be8d152--pubN100633" page="162"/>
    <rule name="All-terrain Vehicle" id="0ae2ef65-ea95-d87d-4a42-28ceb33f30b4" hidden="false">
      <description>reroll dangerous terrain tests while at Combat Speed</description>
    </rule>
    <rule name="Gun Carriage" id="5408-1bbf-2649-ece4" hidden="false" publicationId="2be8d152--pubN100633" page="188"/>
    <rule name="Galvanic Motor" id="fac7-904f-a2cf-e8fe" hidden="false" publicationId="2be8d152--pubN100633" page="229"/>
    <rule name="Immobile" id="2d7a-1a12-e44c-032b" hidden="false" publicationId="2be8d152--pubN174596" page="0"/>
    <rule name="Limited Ammunition" id="cde3-a1d0-1db4-3d37" hidden="false" publicationId="2be8d152--pubN72426" page="52">
      <description>Carries only four rockets and each is a separate weapon that may be destroyed.</description>
    </rule>
    <rule name="Gun Deployment" id="6b8c-4381-68e2-1b44" hidden="false" publicationId="2be8d152--pubN100633" page="75"/>
    <rule name="Artillery Tractor" id="ef02-1e66-0f2d-d626" hidden="false" publicationId="2be8d152--pubN100633" page="75"/>
    <rule name="Sky Lift" id="c8a6-a8bb-66f3-ec20" hidden="false" publicationId="2be8d152--pubN71923" page="16"/>
    <rule name="Tallarn Desert Raiders" id="d621-61e5-498e-561b" hidden="false" publicationId="2be8d152--pubN164097" page="226">
      <description>May re-roll any To Hit rolls of 1 in the Shooting phase.
Gains the Move Through Cover special rule.
May not take Carapace Armour.</description>
    </rule>
    <rule name="Aura of Discipline" id="c807-a17c-fc21-f28b" hidden="false" publicationId="2be8d152--pubN72426" page="0">
      <description>Any friendly Codex: Astra Militarum unit within 6&quot; uses his Leadership for Pinning, Morale, and Fear tests.</description>
    </rule>
    <rule name="Summary Execution" id="25e7-83e1-257d-108a" hidden="false" publicationId="2be8d152--pubN72426" page="33"/>
    <rule name="Chain of Command" id="b4d8-af6b-5720-6398" hidden="false" publicationId="2be8d152--pubN72426" page="0">
      <description>May only be Warlord if no other Senior Officers.</description>
    </rule>
    <rule name="Powerlifter" id="27ea-9a31-1137-20b6" hidden="false" page="223">
      <description>No idea what this rule does</description>
    </rule>
