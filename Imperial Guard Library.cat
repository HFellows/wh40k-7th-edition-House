    <rule name="Warlord Trait: Implacable Determination" id="491a-d157-3036-ec05" hidden="false" page="0" publicationId="2be8d152--pubN72426"/>
    <rule name="Voice of Command" id="2ff26b94-8048-d15d-c541-fd4da0f49571" hidden="false" page="28" publicationId="2be8d152--pubN72426"/>
    <rule name="Combined Squad" id="8fc6-1bc1-604a-fafc" hidden="false" page="0" publicationId="2be8d152--pubN72426">
      <description>May combine Infantry Squads just before rolling for Warlord Traits.</description>
    </rule>
    <rule name="Clarion Vox-net" id="f8dd-adf2-a369-6a44" hidden="false" page="0" publicationId="2be8d152--pubN72426">
      <description>Friendly units within 18&quot; may use this model&apos;s Leadership for Pinning, Morale, and Fear.</description>
    </rule>
    <rule name="Indirect Fire" id="7cbe-b012-ba37-a464" hidden="false" page="0" publicationId="2be8d152--pubN174596"/>
    <rule name="Thunderblitzing &amp; Assaulting the Minotaur" id="d126-10bd-98e8-3487" hidden="false" page="31" publicationId="2be8d152--pubN99523"/>
