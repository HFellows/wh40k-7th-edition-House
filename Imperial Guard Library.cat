    <rule name="Shell Shock" id="fddf-c823-6846-cc52" hidden="false" page="197" publicationId="2be8d152--pubN100633"/>
    <rule name="Heat Seeker" id="0f14-5bd3-e836-0b08" hidden="false" page="5" publicationId="2be8d152--pubN71923"/>
    <rule name="Explosive Demise" id="5df9-f1e9-97d0-c532" hidden="false" page="206" publicationId="2be8d152--pubN100633"/>
    <rule name="Command Tank" id="a371-32f0-a357-c0c9" hidden="false" page="6" publicationId="2be8d152--pubN99523"/>
    <rule name="Shock Pulse" id="4bb5-fd01-76eb-5bc5" hidden="false" page="135" publicationId="2be8d152--pubN99523"/>
    <rule name="Feedback" id="cb18-f3bf-5406-46c4" hidden="false" page="135" publicationId="2be8d152--pubN99523"/>
    <rule name="Doctrine: Forward Sentries" id="b9f3-f559-bdf2-70da" hidden="false" page="38" publicationId="2be8d152--pubN72426"/>
    <rule name="Doctrine: Grenadiers" id="972b-a21a-7ac9-40ce" hidden="false" page="38" publicationId="2be8d152--pubN72426">
      <description>4+ carapace armour</description>
    </rule>
    <rule name="Crack Shot" id="2fde-f6d4-be58-1acd" hidden="false" page="59" publicationId="2be8d152--pubN72426">
      <description>Can re-roll armor penetration. Also bonuses for weapons:
* Battle Cannon, Vanquisher, Demolisher, Eradicator: re-roll To Hit
* Exterminator or Punisher: Rending
* Executioner: may fire 36&quot; S7 AP2 Heavy 1, Large Blast, Blind, Gets Hot</description>
    </rule>
    <rule name="Punitive" id="4338-a0ec-ef62-d3b4" hidden="false" page="167" publicationId="2be8d152--pubN73328">
      <description>A weapon with this special rule always wounds on a roll of 4+. In addition, when making armour saves against attacks made by a weapon with this special rule, a roll of 3 or less will always fail, even if the target&apos;s Save characteristic is 3+ or better.</description>
    </rule>
    <rule name="Brotherhood of Psykers" id="a85b-d2bf-0f8c-755b" hidden="false" page="159" publicationId="2be8d152--pubN229712">
      <description>Model&apos;s unit is Psyker with Mastery Level 1. Manifest from any one model with rule. Hits from Perils or anty-Psyker weapons are randomly allocated.</description>
    </rule>
    <rule name="Psychic Discipline: Biomancy" id="43c7-9ad9-7fd0-0f47" hidden="false" page="0" publicationId="2be8d152--pubN174596"/>
    <rule name="Psychic Discipline: Daemonology" id="27b5-9c29-1c59-ed9e" hidden="false" page="0" publicationId="2be8d152--pubN174596"/>
