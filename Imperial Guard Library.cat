              <profiles>
                <profile name="Rhino" id="e08e-fcb3-666b-a64a" hidden="false" publicationId="7ab0-ceb9-pubN65751" typeId="725a358c-765b-498c-8de5-399fc0c0725f" typeName="Vehicle">
                  <characteristics>
                    <characteristic name="BS" typeId="f6f92f00-8bb1-4afa-8ccb-46310b7dd5e5">4</characteristic>
