    <rule name="Orders: Take Aim!" id="5a0d-c325-01ca-3543" hidden="false" publicationId="2be8d152--pubN72426" page="0"/>
    <rule name="Tank Orders: Full Throttle!" id="b89d-cf77-5a9e-7c6d" hidden="false" publicationId="2be8d152--pubN72426" page="32">
      <description>+3 “ to Movement</description>
    </rule>
    <rule name="Tank Orders: Gunners, Kill on Sight!" id="e4a5-f8df-11ba-85f2" hidden="false" publicationId="2be8d152--pubN72426" page="32">
      <description>The selected unit Gains ignores cover</description>
    </rule>
    <rule name="Tank Orders: Strike and Shroud!" id="43a7-9c74-cb9e-1fa4" hidden="false" publicationId="2be8d152--pubN72426" page="32">
      <description>Ordered vehicle must immediately fire all weapons and then must pop smoke</description>
    </rule>
