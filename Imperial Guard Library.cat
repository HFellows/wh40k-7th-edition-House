    <profile name="Platoon Standard" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item" hidden="false" id="3c3e-a702-d911-a46a" publicationId="2be8d152--pubN72426" page="0">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">A unit that contains a model with a platoon standard counts as scoring an additional Wound for the purposes of calculating assault results.</characteristic>
      </characteristics>
    </profile>
    <profile name="Vox-caster" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item" hidden="false" id="2b9b-f2f2-92db-dd5d" publicationId="2be8d152--pubN72426" page="0">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Failed Leadership tests for orders issued to a unit with a vox-caster can be re-rolled, provided the officer&apos;s unit also has a vox-caster. An officer may not use a vox-caster&apos;s ability on his own unit.</characteristic>
      </characteristics>
    </profile>
