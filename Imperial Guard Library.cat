    <profile name="Leman Russ Executioner" id="fcbb-a555-2bae-3a56" hidden="false" page="47" publicationId="2be8d152--pubN72426" typeId="725a358c-765b-498c-8de5-399fc0c0725f" typeName="Vehicle">
      <characteristics>
        <characteristic name="BS" typeId="f6f92f00-8bb1-4afa-8ccb-46310b7dd5e5">3</characteristic>
