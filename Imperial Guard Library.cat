    <selectionEntryGroup name="Provenances of War" id="f709-701c-030f-9ad8" hidden="false">
      <constraints>
        <constraint id="4f7a-592f-9146-9676" field="selections" scope="parent" shared="true" type="min" value="0"/>
        <constraint id="92c4-8dc0-ca87-8744" field="selections" scope="parent" shared="true" type="max" value="2"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="01 Warrior Elite come back too" id="b192-2b6f-ad8c-959f" collective="false" hidden="false" import="true" page="9" publicationId="48c2-d023-0069-001a" type="upgrade">
          <constraints>
            <constraint id="154b-d405-276d-4412" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="max" value="1"/>
            <constraint id="dce1-eea6-7ee9-3e3c" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0"/>
          </costs>
          <modifiers>
            <modifier field="154b-d405-276d-4412" type="set" value="0">
              <conditionGroups>
                <conditionGroup type="or">
                  <conditions>
                    <condition childId="331b-43fb-e64-9364" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="greaterThan" value="0"/>
                  </conditions>
                </conditionGroup>
              </conditionGroups>
            </modifier>
          </modifiers>
          <rules>
            <rule name="Warrior Elite" id="09a3-925f-64fd-332b" hidden="false" page="9" publicationId="48c2-d023-0069-001a">
              <description>All eligible units and models receive +1 to their Leadership Characteristic (to a maximum of 10). Imperialis Militia Levy Squads in a Detachment with this Provenance gain the Support Squad special rule and all Imperialis Militia Grenadier Squads in a Detachment with this Provenance lose the Support Squad special rule.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="18 Augmented Levy" id="331b-43fb-e64-9364" hidden="false" import="true" page="6" publicationId="bc5c-e6fb-985f-81be" type="upgrade">
          <constraints>
            <constraint id="24a9-5c79-21ac-402f" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="3ec5-f8fe-868-3c4a" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="max" value="1"/>
          </constraints>
          <modifiers>
            <modifier field="3ec5-f8fe-868-3c4a" type="set" value="0">
              <conditionGroups>
                <conditionGroup type="or">
                  <conditions>
                    <condition childId="b192-2b6f-ad8c-959f" field="selections" includeChildSelections="true" scope="force" shared="true" type="atLeast" value="1"/>
                  </conditions>
                </conditionGroup>
              </conditionGroups>
            </modifier>
          </modifiers>
          <rules>
            <rule name="Augmented Levy" id="b147-7837-b14b-8006" hidden="false" page="6" publicationId="bc5c-e6fb-985f-81be">
              <description>All Conscript Squads in a Detachment with this Provenance receive +1 to their Leadership Characteristic and gain the Stubborn and The Rite of Pure Thought special rules However, the Detachment’s Compulsory Troops choices must be filled by Conscript Squads, and it may not have more Infantry units, excepting HQ choices, of other types than it has Conscript Squads in total. For example, if it has three Conscript Squads, it can have a maximum of three additional Infantry squads of other kinds. 

This Provenance cannot be taken in conjunction with the Abhuman Muster, Tainted Flesh, Gene-crafted, Unending Hordes, Feral Warriors or Ogryn Conscripts Provenances.</description>
            </rule>
            <rule name="The Rite of Pure Thought" id="6063-7a50-546f-a5f1" hidden="false">
              <description>A unit with this special rule may not make any Overwatches or Sweeping Advance moves.</description>
            </rule>
          </rules>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
