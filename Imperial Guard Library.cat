                    <characteristic name="HP" typeId="ae95a1af-719f-4365-b951-33cd3ca9148a">3</characteristic>
                    <characteristic name="Type" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Vehicle (Tank, Transport)</characteristic>
                  </characteristics>
                </profile>
                <profile name="Rhino (Transport)" id="c90c-2aef-75a9-e964" hidden="false" publicationId="7ab0-ceb9-pubN65751" typeId="b3a8-0452-7436-44d1" typeName="Transport">
                  <characteristics>
                    <characteristic name="Capacity" typeId="15aa-1916-a38b-d223">10. No Bulky, Very Bulky, or Extremely Bulky</characteristic>
                    <characteristic name="Fire Points" typeId="fe20-e124-2c11-86ee">2. Top Hatch</characteristic>
                    <characteristic name="Access Points" typeId="21e5-4518-a31c-7e56">3. One on each side and one at the rear</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <rules>
                <rule name="Repair" id="9b8b-3715-a718-ea35" hidden="false" publicationId="7ab0-ceb9-pubN65751">
                  <description>If a Rhino is Immobilised, then in subsequent turns, it may attempt to repair itself instead of shooting.  To make the attempt, roll a D6 in the Shooting phase; on a roll of a 6+, the vehicle is no longer Immobilised.  Note that a successful Repair does not restore a Hull Point.</description>
                </rule>
              </rules>
            </selectionEntry>
