    <profile name="Snare Mines" id="5d1a-bafd-5b5c-5153" hidden="false" page="0" publicationId="2be8d152--pubN72426" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
