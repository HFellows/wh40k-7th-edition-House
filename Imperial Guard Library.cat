    <rule name="Orders: Bring it Down!" id="d597-d987-0823-c59e" hidden="false" publicationId="2be8d152--pubN72426" page="0"/>
    <rule name="Orders: Fire and Advance!" id="55a5-3370-66c0-a473" hidden="false" publicationId="2be8d152--pubN73328" page="154">
      <description>The ordered unit must make a shooting attack. The unit count as being stationary, even if it moved in the preceding Movement phase.</description>
    </rule>
    <rule name="Orders: Fire on my Target!" id="cb89-dccf-217d-c1ac" hidden="false" publicationId="2be8d152--pubN72426" page="0"/>
