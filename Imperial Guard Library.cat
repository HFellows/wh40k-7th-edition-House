    <profile name="Slabshield" id="103b-03bf-1dae-a117" hidden="false" page="44" publicationId="2be8d152--pubN72426" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">If a model with a slabshield is in base contact with one or more models with a slabshield from the same unit, it adds +1 to its Armour Save. Furthermore, if a target (friend or foe) is partially obscured from the firer&apos;s view by at least one model with a slabshield, it receives +1 to its cover save.</characteristic>
      </characteristics>
    </profile>
    <profile name="Brute Shield" id="c5f2-e931-87a5-f213" hidden="false" page="44" publicationId="2be8d152--pubN72426" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">5+ Invul Sv, can re-roll To Wound rolls when resolving Hammer of Wrath hits.</characteristic>
      </characteristics>
    </profile>
