      </characteristics>
    </profile>
    <profile name="Standard of the Lost 113th" id="31dd-ca2a-b611-eebb" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">One Veteran in the army that can carry a regimental standard can instead carry the Standard of the Lost 113th. This follows the same rules as a regimental standard. At the start of your Movement phase you can declare that the bearer will plant the standard and fight to the last. The bearer&apos;s unit cannot move, run or charge for the rest of the game, but it and any friendly Cadian units within 18&quot; are Fearless.</characteristic>
      </characteristics>
    </profile>
    <profile name="Volkite Demi-Culverin" id="f429-67a3-5a34-0d16" hidden="false" page="134" publicationId="a716-c1c4-7b26-8424" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
