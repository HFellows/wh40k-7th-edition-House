    <rule name="Orders: First Rank, FIRE! Second Rank, FIRE!" id="975a-6f90-083d-8d0b" hidden="false" page="0" publicationId="2be8d152--pubN72426"/>
    <rule name="Orders: Get Back in the Fight!" id="f1f4-560c-4e2c-3407" hidden="false" page="0" publicationId="2be8d152--pubN72426"/>
    <rule name="Orders: Forwards, for the Emperor!" id="2f80-682c-8107-ae99" hidden="false" page="0" publicationId="2be8d152--pubN72426"/>
    <rule name="Orders: Move! Move! Move!" id="9092-5893-6f7b-d6b4" hidden="false" page="0" publicationId="2be8d152--pubN72426"/>
    <rule name="Orders: Suppressive Fire!" id="9c3e-a64c-4069-f0a5" hidden="false" page="0" publicationId="2be8d152--pubN72426"/>
    <rule name="Orders: Take Aim!" id="5a0d-c325-01ca-3543" hidden="false" page="0" publicationId="2be8d152--pubN72426"/>
    <rule name="Tank Orders: Full Throttle!" id="b89d-cf77-5a9e-7c6d" hidden="false" page="32" publicationId="2be8d152--pubN72426">
      <description>+3 “ to Movement</description>
    </rule>
    <rule name="Tank Orders: Gunners, Kill on Sight!" id="e4a5-f8df-11ba-85f2" hidden="false" page="32" publicationId="2be8d152--pubN72426">
      <description>The selected unit Gains ignores cover</description>
    </rule>
    <rule name="Tank Orders: Strike and Shroud!" id="43a7-9c74-cb9e-1fa4" hidden="false" page="32" publicationId="2be8d152--pubN72426">
      <description>Ordered vehicle must immediately fire all weapons and then must pop smoke</description>
    </rule>
    <rule name="Imperial Guard Orders" id="904f-aa55-e30a-6b69" hidden="false" page="29" publicationId="2be8d152--pubN77996"/>
    <rule name="Navy Orders: Co-ordinate Reserves" id="8064-634f-a82f-d4f2" hidden="false" page="31" publicationId="2be8d152--pubN72426"/>
    <rule name="Navy Orders: Intercept Reserves" id="9087-3e20-a983-1489" hidden="false" page="31" publicationId="2be8d152--pubN72426"/>
