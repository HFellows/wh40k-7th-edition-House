        <selectionEntry type="upgrade" import="true" name="Envenomed Blade" hidden="false" id="966d-0448-9e41-8ab5">
          <profiles>
            <profile name="Envenomed Blade" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon" hidden="false" id="d500-b97f-3ed1-d79a">
              <characteristics>
