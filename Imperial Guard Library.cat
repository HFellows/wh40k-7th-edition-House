    <rule name="Tallarn Desert Raiders" id="d621-61e5-498e-561b" hidden="false" page="226" publicationId="2be8d152--pubN164097">
      <description>May re-roll any To Hit rolls of 1 in the Shooting phase.
Gains the Move Through Cover special rule.
May not take Carapace Armour.</description>
    </rule>
    <rule name="Aura of Discipline" id="c807-a17c-fc21-f28b" hidden="false" page="0" publicationId="2be8d152--pubN72426">
      <description>Any friendly Codex: Astra Militarum unit within 6&quot; uses his Leadership for Pinning, Morale, and Fear tests.</description>
    </rule>
    <rule name="Summary Execution" id="25e7-83e1-257d-108a" hidden="false" page="33" publicationId="2be8d152--pubN72426"/>
    <rule name="Chain of Command" id="b4d8-af6b-5720-6398" hidden="false" page="0" publicationId="2be8d152--pubN72426">
      <description>May only be Warlord if no other Senior Officers.</description>
    </rule>
    <rule name="Powerlifter" id="27ea-9a31-1137-20b6" hidden="false" page="223">
      <description>No idea what this rule does</description>
    </rule>
    <rule name="The Hour is Nigh" id="9d74-dcb4-e835-021f" hidden="false" page="53" publicationId="2be8d152--pubN72426"/>
    <rule name="Overdrive" id="0290-4c4a-ba07-fc2f" hidden="false" page="6" publicationId="2be8d152--pubN99523"/>
    <rule name="Orders: Bring it Down!" id="d597-d987-0823-c59e" hidden="false" page="0" publicationId="2be8d152--pubN72426"/>
    <rule name="Orders: Fire and Advance!" id="55a5-3370-66c0-a473" hidden="false" page="154" publicationId="2be8d152--pubN73328">
      <description>The ordered unit must make a shooting attack. The unit count as being stationary, even if it moved in the preceding Movement phase.</description>
    </rule>
